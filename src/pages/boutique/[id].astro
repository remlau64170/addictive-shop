---
import { render } from "astro:content";
import { Check, Package, ShieldCheck } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProductCard from "../../components/ProductCard.astro";
import { BOUTIQUE_OUVERTE, SHOP_SHELVES } from "../../data/site";
import JsonLd from "../../components/JsonLd.astro";
import { formatPrice, getProduits, productName, thumbnail } from "../../lib/produits";
import { PUBLISHER, absolute } from "../../lib/seo";
import { avisDuProduit, demiEtoiles, moisAnnee, noteMoyenne } from "../../lib/avis";
import Etoiles from "../../components/Etoiles.astro";

export async function getStaticPaths() {
  const produits = await getProduits();
  return produits.map((produit) => ({ params: { id: produit.id }, props: { produit, produits } }));
}

const { produit, produits } = Astro.props;
const { Content } = await render(produit);
const name = productName(produit);
const shelf = SHOP_SHELVES.find((item) => item.id === produit.data.shelf);
const numerique = produit.data.shelf === "numeriques";
/** Achat possible seulement si la boutique est ouverte (réglage de construction) et pour un produit numérique. */
const achat = BOUTIQUE_OUVERTE && numerique && produit.data.price !== null;
const images = produit.data.images;
// Produits liés : ceux du même rayon d'abord.
const liees = produits
  .filter((item) => item.id !== produit.id)
  .sort((a, b) => Number(b.data.shelf === produit.data.shelf) - Number(a.data.shelf === produit.data.shelf))
  .slice(0, 3);

const avis = avisDuProduit(produit.id);
const moyenne = avis.length > 0 ? noteMoyenne(avis) : 0;
const frNote = (note: number) => String(note).replace(".", ",");

// Note et avis seulement s'il existe de vrais avis pour ce produit. La boutique n'est pas ouverte : le produit reste indiqué
// comme indisponible jusqu'à l'ouverture.
const structured = {
  "@type": "Product",
  name,
  description: produit.data.summary,
  image: images.map((image) => absolute(image.src)),
  brand: { "@type": "Brand", name: PUBLISHER.name },
  category: shelf?.label,
  url: absolute(Astro.url.pathname),
  offers: {
    "@type": "Offer",
    url: absolute(Astro.url.pathname),
    priceCurrency: "EUR",
    price: produit.data.price?.toFixed(2),
    availability: "https://schema.org/OutOfStock",
  },
  ...(avis.length > 0
    ? {
        aggregateRating: { "@type": "AggregateRating", ratingValue: moyenne, reviewCount: avis.length, bestRating: 5, worstRating: 1 },
        review: avis.map((item) => ({
          "@type": "Review",
          author: { "@type": "Person", name: item.prenom },
          datePublished: item.date,
          reviewBody: item.texte,
          reviewRating: { "@type": "Rating", ratingValue: item.note, bestRating: 5, worstRating: 1 },
        })),
      }
    : {}),
};
---

<Base title={name} description={produit.data.summary} wide image={images[0]!.src} ogType="product">
  <JsonLd data={structured} />
  <div class="wrap wrap-page">
    <Breadcrumb
      items={[
        { label: "Accueil", href: "/" },
        { label: "Boutique", href: "/boutique/" },
        { label: shelf?.label ?? "", href: shelf?.href ?? "/boutique/" },
        { label: name },
      ]}
    />

    <div class="top">
      <div class="gallery">
        <div class="visual">
          <img id="gallery-main" src={images[0]!.src} width="1000" height="1000" alt={images[0]!.alt} />
          <span class="demo-note">Visuel de démonstration</span>
        </div>
        <ul class="thumbs" aria-label="Images du produit">
          {
            images.map((image, index) => (
              <li>
                <a href={image.src} data-thumb={image.src} data-alt={image.alt} aria-label={`Image ${index + 1} : ${image.alt}`} aria-current={index === 0 ? "true" : undefined}>
                  <img src={thumbnail(image.src)} width="480" height="480" loading="lazy" alt={image.alt} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="buy">
        <h1>{name}</h1>
        <p class="price">{formatPrice(produit.data.price)}</p>
        <p class="lead">{produit.data.summary}</p>
        {
          produit.data.sizes && (
            <div class="sizes">
              <p class="label">Tailles</p>
              <ul>{produit.data.sizes.map((size) => <li>{size}</li>)}</ul>
            </div>
          )
        }
        {
          achat ? (
            <form class="buy-form" method="post" action="/api/checkout">
              <input type="hidden" name="produit" value={produit.id} />
              <button class="button add" type="submit">Acheter</button>
              <p class="soon">Paiement sécurisé sur la page Stripe. Téléchargement juste après le paiement.</p>
              <p class="pay-message" role="status" hidden></p>
            </form>
          ) : (
            <>
              <button class="button add" type="button" disabled>Ajouter au panier</button>
              <p class="soon">La boutique ouvre bientôt.</p>
            </>
          )
        }
        {
          !numerique && (
            <p class="delivery">
              <Package size={18} aria-hidden="true" />
              Fabriqué à la demande, expédié sous 3 à 5 jours ouvrés (délai indicatif).
            </p>
          )
        }
      </div>
    </div>

    <div class="details">
    <div class="details-main">
    <section class="block">
      <h2>Description</h2>
      <div class="prose"><Content /></div>
    </section>

    <section class="block avis" aria-labelledby="avis-title">
      <h2 id="avis-title">Avis</h2>
      {
        avis.length === 0 ? (
          <p class="avis-vide">Pas encore d'avis. Les premiers arriveront après les premières commandes.</p>
        ) : (
          <>
            <p class="avis-resume">
              <Etoiles note={demiEtoiles(moyenne)} label={`Note moyenne : ${frNote(moyenne)} sur 5`} />
              <strong>{frNote(moyenne)} / 5</strong>
              <span>· {avis.length} avis</span>
            </p>
            <ul class="avis-liste">
              {avis.map((item) => (
                <li>
                  <p class="avis-auteur">
                    <strong>{item.prenom}</strong>
                    <span>{moisAnnee(item.date)}</span>
                    {item.verifie && <span class="badge">Achat vérifié</span>}
                  </p>
                  <p><Etoiles note={Math.round(item.note)} label={`Note : ${item.note} sur 5`} /></p>
                  <p>{item.texte}</p>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <p class="avis-note">Les avis sont publiés avec l'accord de leurs auteurs, sans modification du texte.</p>
    </section>
    </div>

    <div class="details-side">
    <section class="block">
      <h2>Ce que contient le produit</h2>
      <ul class="contains">
        {produit.data.contains.map((item) => <li><Check size={18} aria-hidden="true" />{item}</li>)}
      </ul>
    </section>

    <section class="block">
      <h2>Caractéristiques</h2>
      <dl class="specs">
        {
          produit.data.specs.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
      {
        numerique && (
          <p class="notice">
            <ShieldCheck size={18} aria-hidden="true" />
            <span>Ce produit ne remplace pas un professionnel de santé. Si vous en ressentez le besoin, <a href="/aide/">des services d'écoute sont là pour vous</a>.</span>
          </p>
        )
      }
    </section>
    </div>
    </div>

    <section class="block">
      <h2>Pour aller plus loin</h2>
      <ul class="link-list more-links">
        <li><a href="/appli/">Suivez vos habitudes avec l'appli Addictive</a></li>
        <li><a href="/articles/">Lisez nos articles sur la discipline et la remise au sport</a></li>
      </ul>
    </section>

    <section class="block">
      <h2>Produits liés</h2>
      <ul class="product-grid product-grid-3">
        {liees.map((item) => <li><ProductCard produit={item} /></li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .top {
    display: grid;
    gap: 1.25rem;
    margin-top: 0.25rem;
  }

  .top h1 {
    font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.375rem);
  }

  .thumbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .thumbs a {
    display: block;
    border: 2px solid transparent;
    border-radius: var(--radius-control);
    transition: border-color var(--ease);
  }

  .thumbs a:hover {
    border-color: var(--border-strong);
  }

  .thumbs a[aria-current] {
    border-color: var(--primary);
  }

  .thumbs img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius-control) - 2px);
  }

  .price {
    margin-top: 0.625rem;
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
    font-weight: 800;
  }

  .sizes {
    margin-top: 1.25rem;
  }

  .label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .sizes ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.375rem;
  }

  .sizes li {
    min-width: 2.75rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--card);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
  }

  .add {
    width: 100%;
    min-height: 3.25rem;
    margin-top: 1.5rem;
  }

  .soon {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .pay-message {
    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-inner);
    background: var(--card);
    font-size: 0.9375rem;
  }

  .delivery,
  .notice {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.9375rem;
  }

  .delivery :global(svg),
  .notice :global(svg) {
    margin-top: 0.2rem;
    color: var(--success);
  }

  .notice {
    padding: 0.875rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--card);
  }

  .details,
  .block {
    margin-top: var(--space-block);
  }

  .block h2 {
    margin-bottom: 0.875rem;
  }

  .details .block:first-child {
    margin-top: 0;
  }

  .details-side {
    margin-top: var(--space-block);
  }

  .prose {
    margin-top: 0;
    max-width: 42rem;
  }

  .avis-vide {
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--card);
    color: var(--muted-foreground);
  }

  .avis-resume,
  .avis-auteur {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
  }

  .avis-resume {
    font-size: 1.0625rem;
  }

  .avis-liste {
    margin-top: 1rem;
  }

  .avis-liste li {
    padding-block: 1rem;
    border-top: 1px solid var(--border);
  }

  .avis-auteur span {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .avis-note {
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  .contains li {
    display: flex;
    gap: 0.5rem;
    padding-block: 0.3125rem;
  }

  .contains :global(svg) {
    margin-top: 0.2rem;
    color: var(--success);
  }

  .specs {
    margin: 0;
  }

  .specs div {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0 1rem;
    padding-block: 0.625rem;
    border-bottom: 1px solid var(--border);
  }

  .specs div:last-child {
    border-bottom: 0;
  }

  .specs dt {
    color: var(--muted-foreground);
  }

  .specs dd {
    margin: 0;
    font-weight: 600;
  }

  @media (min-width: 768px) {
    .top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(1.5rem, 4vw, 3.5rem);
      align-items: start;
    }

    .buy {
      padding-top: 0.5rem;
    }

    .add {
      width: auto;
      min-width: min(18rem, 100%);
    }

    .more-links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
  }

  /* Grand écran : la description à gauche, le contenu et les caractéristiques dans un encadré à droite. */
  @media (min-width: 1000px) {
    .details {
      display: grid;
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: start;
    }

    .details-side {
      margin-top: 0;
      padding: 1.5rem;
      border: 1px solid var(--border);
      border-radius: var(--radius-card);
      background: var(--card);
    }

    .details-side h2 {
      font-size: 1.25rem;
    }

    .details-side .notice {
      background: var(--secondary);
    }
  }
</style>

<script>
  // Sans JavaScript, chaque vignette ouvre simplement l'image en grand.
  const main = document.querySelector<HTMLImageElement>("#gallery-main");
  const thumbs = [...document.querySelectorAll<HTMLAnchorElement>("[data-thumb]")];
  for (const thumb of thumbs) {
    thumb.addEventListener("click", (event) => {
      event.preventDefault();
      if (main) {
        main.src = thumb.dataset.thumb ?? main.src;
        main.alt = thumb.dataset.alt ?? "";
      }
      for (const other of thumbs) other.removeAttribute("aria-current");
      thumb.setAttribute("aria-current", "true");
    });
  }
</script>

<script>
  // Retour de Stripe (paiement annulé, indisponible…) : un message court sous le bouton « Acheter ».
  const MESSAGES: Record<string, string> = {
    annule: "Paiement annulé : rien n'a été débité. Vous pouvez réessayer quand vous voulez.",
    indisponible: "L'achat de ce produit n'est pas encore disponible.",
    erreur: "Le paiement n'a pas pu démarrer. Réessayez dans un instant.",
    invalide: "Ce produit n'a pas été reconnu.",
  };
  const zone = document.querySelector<HTMLElement>(".pay-message");
  const motif = new URLSearchParams(location.search).get("paiement");
  if (zone && motif && MESSAGES[motif]) {
    zone.textContent = MESSAGES[motif];
    zone.hidden = false;
  }
</script>

---
import { render } from "astro:content";
import { Check, Download, Package, ShieldCheck } from "@lucide/astro";
import { LIVRAISON, PHYSIQUES_EN_VENTE, formatEuros } from "../../data/boutique.js";
import { CONSENTEMENT_RETRACTATION, CONSENTEMENT_VALEUR, RETRACTATION_PHYSIQUE } from "../../data/consentement.js";
import { ACCEPTATION_CGV_VALEUR } from "../../data/legal.js";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProductCard from "../../components/ProductCard.astro";
import { BOUTIQUE_OUVERTE, SHOP_SHELVES } from "../../data/site";
import JsonLd from "../../components/JsonLd.astro";
import { formatPrice, getProduits, productName, thumbnail } from "../../lib/produits";
import { PUBLISHER, absolute } from "../../lib/seo";
import { avisDuProduit, demiEtoiles, moisAnnee, noteMoyenne } from "../../lib/avis";
import Etoiles from "../../components/Etoiles.astro";

export async function getStaticPaths() {
  const produits = await getProduits();
  return produits.map((produit) => ({ params: { id: produit.id }, props: { produit, produits } }));
}

const { produit, produits } = Astro.props;
const { Content } = await render(produit);
const name = productName(produit);
const shelf = SHOP_SHELVES.find((item) => item.id === produit.data.shelf);
const numerique = produit.data.shelf === "numeriques";
/** Description pour les moteurs : l'accroche entière si elle tient en 160 caractères, sinon ses phrases complètes qui tiennent. */
const resume = produit.data.summary;
const descriptionSeo =
  resume.length <= 160
    ? resume
    : (resume.match(/[^.!?]+[.!?]+/g) ?? [resume]).reduce((acc, phrase) => ((acc + phrase).trim().length <= 160 ? acc + phrase : acc), "").trim() || resume.slice(0, 157) + "…";
/** Produit physique réellement en vente (couleurs, tailles), sinon undefined. */
const vente = numerique ? undefined : PHYSIQUES_EN_VENTE[produit.id as keyof typeof PHYSIQUES_EN_VENTE];
const guideTailles = (vente?.guideTailles ?? {}) as Record<string, { largeur: number; longueur: number }>;
/** Achat possible seulement si la boutique est ouverte (réglage de construction), avec un prix, et pour un produit numérique ou un produit physique en vente. */
const achat = BOUTIQUE_OUVERTE && produit.data.price !== null && (numerique || Boolean(vente));
const images = produit.data.images;
// Produits liés : ceux du même rayon d'abord.
const liees = produits
  .filter((item) => item.id !== produit.id)
  .sort((a, b) => Number(b.data.shelf === produit.data.shelf) - Number(a.data.shelf === produit.data.shelf))
  .slice(0, 3);

const avis = avisDuProduit(produit.id);
const moyenne = avis.length > 0 ? noteMoyenne(avis) : 0;
const frNote = (note: number) => String(note).replace(".", ",");

// Note et avis seulement s'il existe de vrais avis pour ce produit. La boutique n'est pas ouverte : le produit reste indiqué
// comme indisponible jusqu'à l'ouverture.
const structured = {
  "@type": "Product",
  name,
  description: produit.data.summary,
  image: images.map((image) => absolute(image.src)),
  brand: { "@type": "Brand", name: PUBLISHER.name },
  category: shelf?.label,
  url: absolute(Astro.url.pathname),
  offers: {
    "@type": "Offer",
    url: absolute(Astro.url.pathname),
    priceCurrency: "EUR",
    price: produit.data.price?.toFixed(2),
    availability: "https://schema.org/OutOfStock",
  },
  ...(avis.length > 0
    ? {
        aggregateRating: { "@type": "AggregateRating", ratingValue: moyenne, reviewCount: avis.length, bestRating: 5, worstRating: 1 },
        review: avis.map((item) => ({
          "@type": "Review",
          author: { "@type": "Person", name: item.prenom },
          datePublished: item.date,
          reviewBody: item.texte,
          reviewRating: { "@type": "Rating", ratingValue: item.note, bestRating: 5, worstRating: 1 },
        })),
      }
    : {}),
};
---

<Base title={name} description={descriptionSeo} wide image={`/partage/produits/${produit.id}.jpg`} ogType="product">
  <JsonLd data={structured} />
  <div class="wrap wrap-page">
    <Breadcrumb
      items={[
        { label: "Accueil", href: "/" },
        { label: "Boutique", href: "/boutique/" },
        { label: shelf?.label ?? "", href: shelf?.href ?? "/boutique/" },
        { label: name },
      ]}
    />

    <div class="top">
      <div class="gallery">
        <div class="visual">
          <img id="gallery-main" src={images[0]!.src} srcset={`${thumbnail(images[0]!.src)} 480w, ${images[0]!.src} 1000w`} sizes="(min-width: 900px) 50vw, 100vw" width="1000" height="1000" fetchpriority="high" alt={images[0]!.alt} />
          <span class="demo-note">Visuel de démonstration</span>
        </div>
        <ul class="thumbs" aria-label="Images du produit">
          {
            images.map((image, index) => (
              <li>
                <a href={image.src} data-thumb={image.src} data-srcset={`${thumbnail(image.src)} 480w, ${image.src} 1000w`} data-alt={image.alt} aria-label={`Image ${index + 1} : ${image.alt}`} aria-current={index === 0 ? "true" : undefined}>
                  <img src={thumbnail(image.src)} width="480" height="480" loading="lazy" alt={image.alt} />
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="buy">
        <h1>{name}</h1>
        {produit.data.slogan && <p class="slogan">« {produit.data.slogan} »</p>}
        <p class="price">
          {formatPrice(produit.data.price)}
          {produit.data.prixSepare && <span class="was">au lieu de <s>{formatPrice(produit.data.prixSepare)}</s></span>}
        </p>
        <p class="lead">{produit.data.summary}</p>
        {produit.data.note && <p class="usage">{produit.data.note}</p>}
        {
          produit.data.sizes && !(achat && vente) && (
            <div class="sizes">
              <p class="label">Tailles</p>
              <ul>{produit.data.sizes.map((size) => <li>{size}</li>)}</ul>
            </div>
          )
        }
        {
          achat ? (
            <form class="buy-form" data-produit={produit.id} data-numerique={numerique ? "oui" : undefined} novalidate>
              {
                vente && (
                  <>
                    <fieldset class="choice">
                      <legend class="label">Couleur</legend>
                      <div class="swatches">
                        {vente.couleurs.map((couleur, index) => (
                          <label class="swatch">
                            <input type="radio" name="couleur" value={couleur.id} checked={index === 0} />
                            <span class={`dot dot-${couleur.id}`} aria-hidden="true" />
                            {couleur.nom}
                          </label>
                        ))}
                      </div>
                    </fieldset>
                    <div class="choice">
                      <label class="label" for={`taille-${produit.id}`}>Taille</label>
                      <select class="size-select" id={`taille-${produit.id}`} name="taille" required>
                        <option value="">Choisir une taille</option>
                        {vente.tailles.map((taille) => <option value={taille}>{taille}</option>)}
                      </select>
                      <p class="choice-hint" hidden>Choisissez une taille pour ajouter le t-shirt au panier.</p>
                    </div>
                    <details class="size-guide">
                      <summary>Guide des tailles</summary>
                      <p>Mesures du t-shirt posé à plat, en centimètres. Coupe unisexe ajustée : prenez votre taille habituelle.</p>
                      <table>
                        <thead><tr><th scope="col">Taille</th><th scope="col">Largeur</th><th scope="col">Longueur</th></tr></thead>
                        <tbody>
                          {vente.tailles.map((taille) => (
                            <tr><th scope="row">{taille}</th><td>{guideTailles[taille].largeur}</td><td>{guideTailles[taille].longueur}</td></tr>
                          ))}
                        </tbody>
                      </table>
                    </details>
                  </>
                )
              }
              <div class="buy-actions">
                <button class="button add" type="submit">Ajouter au panier</button>
                <button class="button button-secondary now" type="button" data-acheter aria-expanded="false" aria-controls={`direct-${produit.id}`}>Acheter maintenant</button>
              </div>
              {
                vente ? (
                  <>
                    <p class="soon">+ {formatEuros(LIVRAISON.montant)} de livraison, {LIVRAISON.delaiJours.min} à {LIVRAISON.delaiJours.max} jours.</p>
                    <p class="offer">Livraison offerte en ajoutant un livre numérique.</p>
                  </>
                ) : (
                  <p class="soon">Téléchargement juste après le paiement.</p>
                )
              }
              <p class="pay-message" role="status" hidden>
                Ajouté au panier. <a href="/panier/">Voir le panier</a>
              </p>
            </form>
            <form
              class="direct"
              id={`direct-${produit.id}`}
              method="post"
              action="/api/checkout"
              data-direct={produit.id}
              novalidate
              hidden
            >
              <p class="direct-title">Acheter maintenant : {name}</p>
              <p class="direct-note">Votre panier n'est pas modifié.</p>
              {
                numerique && (
                  <fieldset class="consent">
                    <legend class="consent-title">
                      <Download size={16} aria-hidden="true" />
                      Accès dès le paiement
                    </legend>
                    <label class="consent-choice">
                      <input type="checkbox" name="consentement" value={CONSENTEMENT_VALEUR} aria-describedby={`consent-hint-${produit.id}`} />
                      <span>{CONSENTEMENT_RETRACTATION}</span>
                    </label>
                    <p class="consent-hint" id={`consent-hint-${produit.id}`} data-indice="consentement" hidden>Cochez la case pour accéder tout de suite à vos livres numériques.</p>
                  </fieldset>
                )
              }
              {!numerique && <p class="note-direct">{RETRACTATION_PHYSIQUE} L'adresse de livraison vous sera demandée sur la page de paiement.</p>}
              <div class="consent">
                <label class="consent-choice">
                  <input type="checkbox" name="cgv" value={ACCEPTATION_CGV_VALEUR} aria-describedby={`cgv-hint-${produit.id}`} />
                  <span>J'ai lu et j'accepte les <a href="/cgv/" target="_blank" rel="noopener">conditions générales de vente<span class="sr-only"> (s'ouvre dans un nouvel onglet)</span></a>.</span>
                </label>
                <p class="consent-hint" id={`cgv-hint-${produit.id}`} data-indice="cgv" hidden>Cochez la case pour accepter les conditions générales de vente.</p>
              </div>
              <input type="hidden" name="panier" />
              <input type="hidden" name="depuis" value={produit.id} />
              <button class="button pay-now" type="submit">Payer {formatPrice(produit.data.price)}{vente ? ` + ${formatEuros(LIVRAISON.montant)} de livraison` : ""}</button>
              <p class="soon">Paiement sécurisé par carte sur la page Stripe.</p>
            </form>
            <p class="pay-message direct-message" role="status" data-message-direct hidden></p>
          ) : (
            <>
              <button class="button add" type="button" disabled>Ajouter au panier</button>
              <p class="soon">La boutique ouvre bientôt.</p>
            </>
          )
        }
        {
          !numerique && (
            <p class="delivery">
              <Package size={18} aria-hidden="true" />
              Fabriqué à la commande, livré en 4 à 7 jours (délai indicatif, 30 jours maximum).
            </p>
          )
        }
      </div>
    </div>

    <div class="details">
    <div class="details-main">
    <section class="block">
      <h2>Description</h2>
      <div class="prose"><Content /></div>
    </section>

    <section class="block avis" aria-labelledby="avis-title">
      <h2 id="avis-title">Avis</h2>
      {
        avis.length === 0 ? (
          <p class="avis-vide">Pas encore d'avis. Les premiers arriveront après les premières commandes.</p>
        ) : (
          <>
            <p class="avis-resume">
              <Etoiles note={demiEtoiles(moyenne)} label={`Note moyenne : ${frNote(moyenne)} sur 5`} />
              <strong>{frNote(moyenne)} / 5</strong>
              <span>· {avis.length} avis</span>
            </p>
            <ul class="avis-liste">
              {avis.map((item) => (
                <li>
                  <p class="avis-auteur">
                    <strong>{item.prenom}</strong>
                    <span>{moisAnnee(item.date)}</span>
                    {item.verifie && <span class="badge">Achat vérifié</span>}
                  </p>
                  <p><Etoiles note={Math.round(item.note)} label={`Note : ${item.note} sur 5`} /></p>
                  <p>{item.texte}</p>
                </li>
              ))}
            </ul>
          </>
        )
      }
      <p class="avis-note">Les avis sont publiés avec l'accord de leurs auteurs, sans modification du texte.</p>
    </section>
    </div>

    <div class="details-side">
    <section class="block">
      <h2>Ce que contient le produit</h2>
      <ul class="contains">
        {produit.data.contains.map((item) => <li><Check size={18} aria-hidden="true" />{item}</li>)}
      </ul>
    </section>

    <section class="block">
      <h2>Caractéristiques</h2>
      <dl class="specs">
        {
          produit.data.specs.map(({ label, value }) => (
            <div>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </div>
          ))
        }
      </dl>
      {
        numerique && (
          <p class="notice">
            <ShieldCheck size={18} aria-hidden="true" />
            {
              produit.data.avertissement ? (
                <span>{produit.data.avertissement} <a href="/aide/">Numéros d'aide et services d'écoute</a>.</span>
              ) : (
                <span>Ce produit ne remplace pas un professionnel de santé. Si vous en ressentez le besoin, <a href="/aide/">des services d'écoute sont là pour vous</a>.</span>
              )
            }
          </p>
        )
      }
    </section>
    </div>
    </div>

    <section class="block">
      <h2>Pour aller plus loin</h2>
      <ul class="link-list more-links">
        <li><a href="/appli/">Suivez vos habitudes avec l'appli Addictive</a></li>
        <li><a href="/articles/">Lisez nos articles sur la discipline et la remise au sport</a></li>
      </ul>
    </section>

    <section class="block">
      <h2>Produits liés</h2>
      <ul class="product-grid product-grid-3">
        {liees.map((item) => <li><ProductCard produit={item} /></li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .top {
    display: grid;
    gap: 1.25rem;
    margin-top: 0.25rem;
  }

  .top h1 {
    font-size: clamp(1.625rem, 1.3rem + 1.4vw, 2.375rem);
  }

  .thumbs {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .thumbs a {
    display: block;
    border: 2px solid transparent;
    border-radius: var(--radius-control);
    transition: border-color var(--ease);
  }

  .thumbs a:hover {
    border-color: var(--border-strong);
  }

  .thumbs a[aria-current] {
    border-color: var(--primary);
  }

  .thumbs img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: calc(var(--radius-control) - 2px);
  }

  .price {
    margin-top: 0.625rem;
    font-size: clamp(1.375rem, 1.2rem + 0.8vw, 1.75rem);
    font-weight: 800;
  }

  .sizes {
    margin-top: 1.25rem;
  }

  .label {
    font-size: 0.875rem;
    font-weight: 600;
  }

  .sizes ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.375rem;
  }

  .sizes li {
    min-width: 2.75rem;
    padding: 0.375rem 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--card);
    font-size: 0.875rem;
    font-weight: 600;
    text-align: center;
  }

  /* Deux boutons : côte à côte s'il y a la place, l'un sous l'autre sur un petit téléphone. */
  .buy-actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 11rem), 1fr));
    gap: 0.625rem;
    margin-top: 1.5rem;
  }

  .buy > .add {
    margin-top: 1.5rem;
  }

  .add,
  .now {
    width: 100%;
    min-height: 3.25rem;
    padding-inline: 1rem;
    white-space: nowrap;
  }

  .direct {
    margin-top: 1rem;
    padding: 1rem 1.125rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-card);
    background: color-mix(in oklch, var(--card) 70%, transparent);
  }

  .direct-title {
    font-weight: 700;
  }

  .direct-note,
  .note-direct {
    margin-top: 0.25rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .note-direct {
    margin-top: 0.75rem;
  }

  .direct .consent {
    margin: 1rem 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .consent-title {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-bottom: 0.5rem;
    padding: 0;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .consent-title :global(svg) {
    color: var(--primary);
  }

  .consent-choice {
    display: flex;
    align-items: flex-start;
    gap: 0.625rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.5;
    cursor: pointer;
  }

  .consent-choice input {
    flex: none;
    width: 1.125rem;
    height: 1.125rem;
    margin: 0.15rem 0 0;
    accent-color: var(--primary);
    cursor: pointer;
  }

  .consent-hint {
    margin: 0.5rem 0 0 1.75rem;
    font-size: 0.875rem;
  }

  .pay-now {
    width: 100%;
    min-height: 3.25rem;
    margin-top: 1.25rem;
  }

  .soon {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .choice {
    margin: 1.25rem 0 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .choice .label {
    margin-bottom: 0.5rem;
    padding: 0;
  }

  .swatches {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .swatch {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.5rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .swatch:has(input:checked) {
    border-color: var(--primary);
    background: color-mix(in oklch, var(--primary) 12%, transparent);
  }

  .swatch:has(input:focus-visible) {
    outline: 2px solid var(--ring);
    outline-offset: 2px;
  }

  .swatch input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .dot {
    width: 1rem;
    height: 1rem;
    border: 1px solid var(--border-strong);
    border-radius: 50%;
  }

  .dot-noir {
    background: #111;
  }

  .dot-blanc {
    background: #f4f4f4;
  }

  .size-select {
    width: 100%;
    max-width: 18rem;
    min-height: 2.75rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background: var(--card);
    color: var(--foreground);
    font: inherit;
  }

  .choice-hint {
    margin-top: 0.5rem;
    font-size: 0.875rem;
  }

  .size-guide {
    margin-top: 0.75rem;
    font-size: 0.875rem;
  }

  .size-guide summary {
    width: fit-content;
    color: var(--primary);
    cursor: pointer;
  }

  .size-guide p {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
  }

  .size-guide table {
    width: 100%;
    max-width: 22rem;
    margin-top: 0.5rem;
    border-collapse: collapse;
    font-variant-numeric: tabular-nums;
  }

  .size-guide th,
  .size-guide td {
    padding: 0.35rem 0.5rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }

  .offer {
    margin-top: 0.25rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .pay-message {

    margin-top: 0.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-inner);
    background: var(--card);
    font-size: 0.9375rem;
  }

  .delivery,
  .slogan {
    margin-top: 0.25rem;
    color: var(--muted-foreground);
    font-style: italic;
  }

  .was {
    margin-left: 0.6rem;
    color: var(--muted-foreground);
    font-size: 1rem;
    font-weight: 400;
  }

  .usage {
    margin-top: 0.75rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-inner);
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .notice {
    display: flex;
    gap: 0.5rem;
    margin-top: 1rem;
    font-size: 0.9375rem;
  }

  .delivery :global(svg),
  .notice :global(svg) {
    margin-top: 0.2rem;
    color: var(--success);
  }

  .notice {
    padding: 0.875rem 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--card);
  }

  .details,
  .block {
    margin-top: var(--space-block);
  }

  .block h2 {
    margin-bottom: 0.875rem;
  }

  .details .block:first-child {
    margin-top: 0;
  }

  .details-side {
    margin-top: var(--space-block);
  }

  .prose {
    margin-top: 0;
    max-width: 42rem;
  }

  .avis-vide {
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--card);
    color: var(--muted-foreground);
  }

  .avis-resume,
  .avis-auteur {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
  }

  .avis-resume {
    font-size: 1.0625rem;
  }

  .avis-liste {
    margin-top: 1rem;
  }

  .avis-liste li {
    padding-block: 1rem;
    border-top: 1px solid var(--border);
  }

  .avis-auteur span {
    color: var(--muted-foreground);

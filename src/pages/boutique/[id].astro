<script>
  // Sans JavaScript, chaque vignette ouvre simplement l'image en grand.
  const main = document.querySelector<HTMLImageElement>("#gallery-main");
  const thumbs = [...document.querySelectorAll<HTMLAnchorElement>("[data-thumb]")];
  for (const thumb of thumbs) {
    thumb.addEventListener("click", (event) => {
      event.preventDefault();
      if (main) {
        main.srcset = thumb.dataset.srcset ?? "";
        main.src = thumb.dataset.thumb ?? main.src;
        main.alt = thumb.dataset.alt ?? "";
      }
      for (const other of thumbs) other.removeAttribute("aria-current");
      thumb.setAttribute("aria-current", "true");
    });
  }
</script>

<script>
  import { ajouterAuPanier } from "../../scripts/panier";

  // « Ajouter au panier » : le panier est gardé dans ce navigateur, sans compte client.
  for (const form of document.querySelectorAll<HTMLFormElement>(".buy-form")) {
    const message = form.querySelector<HTMLElement>(".pay-message");
    const taille = form.querySelector<HTMLSelectElement>('select[name="taille"]');
    const indice = form.querySelector<HTMLElement>(".choice-hint");
    taille?.addEventListener("change", () => {
      if (taille.value && indice) indice.hidden = true;
    });
    form.addEventListener("submit", (event) => {
      event.preventDefault();
      if (taille && !taille.value) {
        if (indice) {
          indice.textContent = "Choisissez une taille pour ajouter le t-shirt au panier.";
          indice.hidden = false;
        }
        taille.focus();
        return;
      }
      const couleur = form.querySelector<HTMLInputElement>('input[name="couleur"]:checked')?.value;
      ajouterAuPanier({ id: form.dataset.produit!, couleur, taille: taille?.value }, form.dataset.numerique === "oui");
      if (message) message.hidden = false;
    });

    // « Acheter maintenant » : paiement de ce seul produit, sans toucher au panier. Les cases obligatoires sont les mêmes
    // qu'au panier ; le serveur revérifie tout (prix, port, cases) et renvoie ici en cas de souci.
    const direct = document.querySelector<HTMLFormElement>(`form[data-direct="${form.dataset.produit}"]`);
    const bouton = form.querySelector<HTMLButtonElement>("[data-acheter]");
    if (!direct || !bouton) continue;
    const champPanier = direct.querySelector<HTMLInputElement>('input[name="panier"]')!;
    const messageDirect = document.querySelector<HTMLElement>("[data-message-direct]");
    const ouvrir = () => {
      direct.hidden = false;
      bouton.setAttribute("aria-expanded", "true");
    };
    const ligne = () => {
      const couleur = form.querySelector<HTMLInputElement>('input[name="couleur"]:checked')?.value;
      return taille ? { id: form.dataset.produit!, couleur, taille: taille.value, quantite: 1 } : { id: form.dataset.produit!, quantite: 1 };
    };
    bouton.addEventListener("click", () => {
      if (taille && !taille.value) {
        if (indice) {
          indice.textContent = "Choisissez une taille pour acheter le t-shirt.";
          indice.hidden = false;
        }
        taille.focus();
        return;
      }
      ouvrir();
      direct.scrollIntoView({ behavior: "smooth", block: "nearest" });
      direct.querySelector<HTMLInputElement>('input[type="checkbox"]')?.focus({ preventScroll: true });
    });
    direct.addEventListener("submit", (event) => {
      if (taille && !taille.value) {
        event.preventDefault();
        if (indice) indice.hidden = false;
        taille.focus();
        return;
      }
      let premiere: HTMLInputElement | null = null;
      for (const caseObligatoire of direct.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) {
        const aide = direct.querySelector<HTMLElement>(`[data-indice="${caseObligatoire.name}"]`);
        if (aide) aide.hidden = caseObligatoire.checked;
        if (!caseObligatoire.checked && !premiere) premiere = caseObligatoire;
      }
      if (premiere) {
        event.preventDefault();
        premiere.focus();
        return;
      }
      champPanier.value = JSON.stringify([ligne()]);
    });
    for (const caseObligatoire of direct.querySelectorAll<HTMLInputElement>('input[type="checkbox"]')) {
      caseObligatoire.addEventListener("change", () => {
        const aide = direct.querySelector<HTMLElement>(`[data-indice="${caseObligatoire.name}"]`);
        if (aide && caseObligatoire.checked) aide.hidden = true;
      });
    }

    // Retour du serveur ou de Stripe sur la fiche : un message court, et les cases à cocher si elles manquaient.
    const MESSAGES: Record<string, string> = {
      annule: "Paiement annulé : rien n'a été débité.",
      indisponible: "Ce produit n'est pas disponible pour le moment.",
      erreur: "Le paiement n'a pas pu démarrer. Réessayez dans un instant.",
      invalide: "Le choix n'a pas été reconnu. Vérifiez la couleur et la taille, puis réessayez.",
    };
    const motif = new URLSearchParams(location.search).get("paiement");
    if (motif === "cgv" || motif === "consentement") {
      ouvrir();
      const aide = direct.querySelector<HTMLElement>(`[data-indice="${motif}"]`);
      if (aide) aide.hidden = false;
    } else if (motif && MESSAGES[motif] && messageDirect) {
      messageDirect.textContent = MESSAGES[motif];
      messageDirect.hidden = false;
    }
  }
</script>

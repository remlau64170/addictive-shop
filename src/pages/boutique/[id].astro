---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProductCard from "../../components/ProductCard.astro";
import { SHOP_SHELVES } from "../../data/site";
import { formatPrice, getProduits, productName } from "../../lib/produits";

export async function getStaticPaths() {
  const produits = await getProduits();
  return produits.map((produit) => ({ params: { id: produit.id }, props: { produit, produits } }));
}

const { produit, produits } = Astro.props;
const { Content } = await render(produit);
const name = productName(produit);
const shelf = SHOP_SHELVES.find((item) => item.id === produit.data.shelf);
// Produits liés : ceux du même rayon d'abord.
const liees = produits
  .filter((item) => item.id !== produit.id)
  .sort((a, b) => Number(b.data.shelf === produit.data.shelf) - Number(a.data.shelf === produit.data.shelf))
  .slice(0, 3);
---

<Base title={name} description={produit.data.summary} wide>
  <div class="wrap fiche">
    <Breadcrumb
      items={[
        { label: "Accueil", href: "/" },
        { label: "Boutique", href: "/boutique/" },
        { label: shelf?.label ?? "", href: `/boutique/#type=${produit.data.shelf}` },
        { label: name },
      ]}
    />

    <div class="top">
      <div class="visual">
        <img src={produit.data.image} width="400" height="400" alt={`Visuel provisoire : ${produit.data.kind.toLowerCase()}`} />
        <span class="badge badge-violet">Visuel provisoire</span>
      </div>
      <div>
        <h1>{name}</h1>
        <p class="price">{formatPrice(produit.data.price)}</p>
        <p class="lead">{produit.data.summary}</p>
        <button class="button add" type="button" disabled>Ajouter au panier</button>
        <p class="soon">La boutique ouvre bientôt.</p>
      </div>
    </div>

    <section class="block">
      <h2>Description</h2>
      <div class="prose"><Content /></div>
    </section>

    <section class="block">
      <h2>Produits liés</h2>
      <ul class="product-grid product-grid-3">
        {liees.map((item) => <li><ProductCard produit={item} /></li>)}
      </ul>
    </section>
  </div>
</Base>

<style>
  .fiche {
    padding-top: 0.5rem;
  }

  .top {
    display: grid;
    gap: 1.25rem;
    margin-top: 0.25rem;
  }

  .top h1 {
    font-size: 1.625rem;
  }

  .price {
    margin-top: 0.75rem;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .add {
    width: 100%;
    margin-top: 1.25rem;
  }

  .soon {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .block {
    margin-top: 2.5rem;
  }

  .block h2 {
    margin-bottom: 0.75rem;
  }

  .prose {
    margin-top: 0;
    max-width: 42rem;
  }

  @media (min-width: 768px) {
    .top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 2.5rem;
      align-items: start;
    }

    .top .visual {
      max-width: 32rem;
    }

    .top h1 {
      font-size: 2rem;
    }

    .add {
      width: auto;
      min-width: 16rem;
    }
  }
</style>

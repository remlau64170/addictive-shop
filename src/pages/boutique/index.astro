---
import { SlidersHorizontal } from "@lucide/astro";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import ProductCard from "../../components/ProductCard.astro";
import { SHOP_NEEDS, SHOP_SHELVES } from "../../data/site";
import { getProduits } from "../../lib/produits";

const produits = await getProduits();
// Le tri et le filtre par prix s'activent seuls dès qu'un prix est renseigné.
const hasPrices = produits.some((produit) => produit.data.price !== null);
---

<Base title="Boutique" description="Boutique Addictive : produits numériques et physiques, bientôt disponibles." wide>
  <div class="wrap shop">
    <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "Boutique" }]} />
    <h1>Boutique</h1>

    <div class="toolbar">
      <p id="shop-count" aria-live="polite">{produits.length} produits</p>
      <div class="controls needs-js">
        <button id="filters-toggle" class="button button-secondary" type="button" aria-expanded="false" aria-controls="filters">
          <SlidersHorizontal size={18} aria-hidden="true" />
          Filtrer
        </button>
        <label>
          Trier par
          <select id="shop-sort">
            <option value="nouveautes">Nouveautés</option>
            <option value="prix-asc" disabled={!hasPrices}>Prix croissant</option>
            <option value="prix-desc" disabled={!hasPrices}>Prix décroissant</option>
          </select>
        </label>
      </div>
    </div>

    <div class="shop-layout">
      <aside id="filters" class="filters needs-js" aria-label="Filtres">
        <fieldset>
          <legend>Type</legend>
          {
            SHOP_SHELVES.map((shelf) => (
              <label><input type="checkbox" data-filter="type" value={shelf.id} />{shelf.label}</label>
            ))
          }
        </fieldset>
        <fieldset>
          <legend>Besoin</legend>
          {
            SHOP_NEEDS.map((need) => (
              <label><input type="checkbox" data-filter="besoin" value={need.id} />{need.label}</label>
            ))
          }
        </fieldset>
        <fieldset disabled={!hasPrices}>
          <legend>Prix</legend>
          <div class="prices">
            <label>Min (€)<input id="price-min" type="number" min="0" inputmode="decimal" /></label>
            <label>Max (€)<input id="price-max" type="number" min="0" inputmode="decimal" /></label>
          </div>
          {!hasPrices && <p class="hint">Les prix ne sont pas encore fixés.</p>}
        </fieldset>
        <button id="filters-reset" class="reset" type="button">Effacer les filtres</button>
      </aside>

      <div class="results">
        <ul id="shop-grid" class="product-grid product-grid-3">
          {
            produits.map((produit) => (
              <li
                data-order={produit.data.order}
                data-price={produit.data.price ?? ""}
                data-type={produit.data.shelf}
                data-besoins={produit.data.needs.join(" ")}
              >
                <ProductCard produit={produit} heading="h2" />
              </li>
            ))
          }
        </ul>
        <p id="shop-empty" class="card" hidden>Aucun produit ne correspond à ces filtres. Essayez d'en retirer un.</p>
      </div>
    </div>
  </div>
</Base>

<style>
  .shop {
    padding-top: 0.5rem;
  }

  .toolbar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    margin-block: 0.5rem 1rem;
  }

  #shop-count {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }

  .controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }

  .controls label {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.875rem;
  }

  select,
  .prices input {
    min-height: 2.75rem;
    min-width: 0;
    max-width: 100%;
    padding: 0.25rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.75rem;
    background: var(--card);
    color: var(--foreground);
    font: inherit;
  }

  /* Sur téléphone, les filtres s'ouvrent avec le bouton « Filtrer ». */
  .filters {
    display: none;
    margin-bottom: 1rem;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }

  .filters.open {
    display: block;
  }

  fieldset {
    min-width: 0;
    margin: 0 0 1rem;
    padding: 0;
    border: 0;
  }

  legend {
    padding: 0;
    font-weight: 700;
  }

  fieldset > label {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    min-height: 2.75rem;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  input[type="checkbox"] {
    flex-shrink: 0;
    width: 1.25rem;
    height: 1.25rem;
    margin: 0;
    accent-color: var(--primary);
  }

  .prices {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .prices label {
    min-width: 0;
    font-size: 0.8125rem;
  }

  .prices input {
    display: block;
    width: 100%;
  }

  fieldset:disabled {
    color: var(--muted-foreground);
  }

  .hint {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.8125rem;
  }

  .reset {
    min-height: 2.75rem;
    padding: 0;
    border: 0;
    background: none;
    color: var(--primary-soft-foreground);
    font: inherit;
    font-size: 0.875rem;
    text-decoration: underline;
    cursor: pointer;
  }

  .results {
    min-width: 0;
  }

  @media (min-width: 900px) {
    #filters-toggle {
      display: none;
    }

    .shop-layout {
      display: grid;
      grid-template-columns: 15rem minmax(0, 1fr);
      gap: 2rem;
      align-items: start;
    }

    .filters {
      display: block;
      margin-bottom: 0;
    }
  }
</style>

<script>
  const grid = document.querySelector<HTMLElement>("#shop-grid")!;
  const items = [...grid.children] as HTMLElement[];
  const count = document.querySelector("#shop-count")!;
  const empty = document.querySelector<HTMLElement>("#shop-empty")!;
  const sort = document.querySelector<HTMLSelectElement>("#shop-sort")!;
  const min = document.querySelector<HTMLInputElement>("#price-min")!;
  const max = document.querySelector<HTMLInputElement>("#price-max")!;
  const boxes = [...document.querySelectorAll<HTMLInputElement>("[data-filter]")];
  const filters = document.querySelector<HTMLElement>("#filters")!;
  const toggle = document.querySelector<HTMLButtonElement>("#filters-toggle")!;

  const checked = (name: string) =>
    boxes.filter((box) => box.dataset.filter === name && box.checked).map((box) => box.value);
  const price = (item: HTMLElement) => (item.dataset.price ? Number(item.dataset.price) : null);

  function matches(item: HTMLElement) {
    const types = checked("type");
    const needs = checked("besoin");
    const value = price(item);
    if (types.length > 0 && !types.includes(item.dataset.type ?? "")) return false;
    if (needs.length > 0 && !(item.dataset.besoins ?? "").split(" ").some((need) => needs.includes(need))) return false;
    if (min.value && (value === null || value < Number(min.value))) return false;
    if (max.value && (value === null || value > Number(max.value))) return false;
    return true;
  }

  // Les produits sans prix passent toujours après les autres.
  function compare(a: HTMLElement, b: HTMLElement) {
    const order = Number(a.dataset.order) - Number(b.dataset.order);
    if (sort.value === "nouveautes") return order;
    const [priceA, priceB] = [price(a), price(b)];
    if (priceA === null || priceB === null) return (priceA === null ? 1 : 0) - (priceB === null ? 1 : 0) || order;
    return (sort.value === "prix-asc" ? priceA - priceB : priceB - priceA) || order;
  }

  function apply() {
    let visible = 0;
    for (const item of [...items].sort(compare)) {
      item.hidden = !matches(item);
      if (!item.hidden) visible += 1;
      grid.append(item);
    }
    count.textContent = visible <= 1 ? `${visible} produit` : `${visible} produits`;
    empty.hidden = visible > 0;
  }

  // Les filtres vivent après le # : les liens du menu y mènent et rien n'est envoyé au serveur.
  function writeHash() {
    const params = new URLSearchParams();
    for (const value of checked("type")) params.append("type", value);
    for (const value of checked("besoin")) params.append("besoin", value);
    if (min.value) params.set("min", min.value);
    if (max.value) params.set("max", max.value);
    if (sort.value !== "nouveautes") params.set("tri", sort.value);
    const hash = params.toString();
    history.replaceState(null, "", hash ? `#${hash}` : location.pathname);
  }

  function readHash() {
    const params = new URLSearchParams(location.hash.slice(1));
    for (const box of boxes) box.checked = params.getAll(box.dataset.filter ?? "").includes(box.value);
    min.value = params.get("min") ?? "";
    max.value = params.get("max") ?? "";
    const tri = params.get("tri");
    const option = [...sort.options].find((item) => item.value === tri && !item.disabled);
    sort.value = option?.value ?? "nouveautes";
    apply();
  }

  function update() {
    writeHash();
    apply();
  }

  for (const control of [...boxes, min, max, sort]) control.addEventListener("input", update);
  document.querySelector("#filters-reset")?.addEventListener("click", () => {
    for (const box of boxes) box.checked = false;
    min.value = "";
    max.value = "";
    update();
  });
  toggle.addEventListener("click", () => {
    const open = filters.classList.toggle("open");
    toggle.setAttribute("aria-expanded", String(open));
  });
  addEventListener("hashchange", readHash);
  readHash();
</script>

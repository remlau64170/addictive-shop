---
// À relire par Rémy : tous les textes de cette page sont des propositions.
import { HeartHandshake, MessageCircleHeart, Sparkles } from "@lucide/astro";
import { POURQUOI_PARAGRAPHES, POURQUOI_TITRE } from "../data/pourquoi";
import Base from "../layouts/Base.astro";
import Breadcrumb from "../components/Breadcrumb.astro";

const VALEURS = [
  { title: "Bienveillance", text: "Nous vous encourageons à chaque étape, à votre rythme. Une journée difficile n'efface jamais le chemin parcouru.", Icon: HeartHandshake },
  { title: "Sans jugement, sans blabla", text: "Des repères simples et concrets, pour avancer à votre rythme, sans leçon de morale.", Icon: Sparkles },
  { title: "100 % à l'écoute", text: "Une question, un retour, un coup de mou ? Écrivez-moi, je réponds à chaque message.", Icon: MessageCircleHeart, lien: { href: "/contact/", label: "Écrire à Addictive" } },
] as const;
---

<Base title="À propos : notre mission" description="Addictive aide à construire de meilleures habitudes : développement personnel, discipline, remise au sport et sobriété, avec bienveillance et sans jugement.">
  <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "À propos" }]} />
  <h1>À propos d'Addictive</h1>

  <section class="pourquoi" aria-labelledby="pourquoi-title">
    <h2 id="pourquoi-title">{POURQUOI_TITRE}</h2>
    {POURQUOI_PARAGRAPHES.map((paragraphe) => <p>{paragraphe}</p>)}
  </section>

  <p class="lead">Nous croyons que les grands changements se construisent avec de petites habitudes, répétées chaque jour.</p>

  <div class="prose">
    <h2>Notre mission</h2>
    <p>
      Vous aider à prendre le contrôle de votre quotidien : installer de bonnes habitudes, renforcer votre mental, bouger
      davantage et, si c'est votre chemin, avancer vers la sobriété. Notre slogan le résume : « Sois addict à ta sobriété ».
    </p>

    <h2>L'appli et la boutique</h2>
    <p>
      <a href="/appli/">L'appli Addictive</a> vous permet de suivre vos séries et votre progression, et vous soutient quand une
      envie arrive. <a href="/boutique/">La boutique</a> propose des programmes, des cartes et des objets pour vous accompagner
      au quotidien. <a href="/articles/">Les articles</a> partagent des repères simples sur le mental, le sport et le
      changement d'habitudes.
    </p>

    <h2>Nos valeurs</h2>
  </div>

  <ul class="values">
    {
      VALEURS.map((valeur) => (
        <li class="card">
          <h3 class="card-title"><valeur.Icon size={22} color="var(--success)" aria-hidden="true" />{valeur.title}</h3>
          <p>{valeur.text}</p>
          {"lien" in valeur && <a class="value-link" href={valeur.lien.href}>{valeur.lien.label}</a>}
        </li>
      ))
    }
  </ul>

  <p class="section">
    Nos contenus ne remplacent pas l'avis d'un professionnel de santé. Si vous en ressentez le besoin, tous les numéros sont sur
    la page <a href="/aide/">Besoin d'aide ?</a>
  </p>
</Base>

<style>
  .pourquoi {
    max-width: 40rem;
    margin-top: 1rem;
  }

  .pourquoi p {
    margin-top: 1rem;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .pourquoi p:first-of-type {
    color: var(--foreground);
  }

  .values {
    display: grid;
    gap: 0.75rem;
    margin-top: 1rem;
  }

  .values .card {
    display: flex;
    flex-direction: column;
  }

  .value-link {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    min-height: 2.75rem;
    margin-top: auto;
    font-weight: 600;
  }

</style>

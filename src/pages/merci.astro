---
import Base from "../layouts/Base.astro";
---

<!-- Page de retour après le paiement Stripe. Le lien de téléchargement n'est donné qu'après une vérification côté serveur. -->
<Base title="Merci pour votre commande" description="Votre commande Addictive : vérification du paiement et lien de téléchargement personnel de votre produit numérique." noindex>
  <div class="empty merci">
    <h1>Merci pour votre commande</h1>
    <div class="state" data-state="verification" role="status" aria-live="polite">
      <p class="lead" data-show="verification">Vérification de votre paiement…</p>

      <div data-show="paye" hidden>
        <p class="lead">Votre paiement est confirmé.</p>
        <div data-guides hidden>
          <ul class="downloads" data-liste-guides></ul>
        </div>
        <div class="shipped" data-articles hidden>
          <p class="lead">Vos articles sont fabriqués à la commande puis expédiés : livraison en 4 à 7 jours ouvrés.</p>
          <ul data-liste-articles></ul>
          <p class="note">Vous gardez 14 jours de rétractation à compter de la réception de vos articles.</p>
        </div>
        <p class="note accord" data-accord-zone hidden>
          Votre accord lors de l'achat, le <span data-accord-date></span> : « <span data-accord></span> » Il figure aussi sur
          votre facture.
        </p>
        <p class="note" data-note-liens>
          Chaque lien personnel fonctionne une seule fois, pendant <span data-minutes>15</span> minutes. Besoin de nouveaux liens ?
          Rechargez cette page (encore <span data-restants></span> fois). Votre facture, envoyée par e-mail, contient aussi le lien de
          cette page. Pour écrire dans les livres remplissables, ouvrez-les avec Adobe Acrobat Reader ou Xodo.
        </p>
      </div>

      <div data-show="non_paye" hidden>
        <p class="lead">Votre paiement n'est pas encore confirmé. Si vous venez de payer, patientez un instant puis rechargez cette page.</p>
      </div>

      <div data-show="limite" hidden>
        <p class="lead">Vous avez utilisé tous les liens de téléchargement de cette commande. Écrivez-nous et nous vous renverrons votre fichier.</p>
        <p class="section"><a class="button" href="/contact/">Nous écrire</a></p>
      </div>

      <div data-show="invalide" hidden>
        <p class="lead">Nous ne retrouvons pas cette commande. Si vous avez été débité, écrivez-nous avec l'e-mail de votre reçu Stripe.</p>
        <p class="section"><a class="button" href="/contact/">Nous écrire</a></p>
      </div>

      <div data-show="erreur" hidden>
        <p class="lead">La vérification n'a pas abouti pour le moment. Rechargez cette page dans un instant.</p>
      </div>
    </div>
  </div>
</Base>

<style>
  .downloads,
  .shipped ul {
    display: grid;
    gap: 0.75rem;
    justify-items: center;
    margin-top: 1.25rem;
  }

  .shipped {
    margin-top: 1.5rem;
  }

  .downloads :global(.livre-titre) {
    font-weight: 700;
  }

  .downloads :global(.livre-liens) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .merci .note {
    max-width: 34rem;
    margin: 1rem auto 0;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }
</style>

<script>
  import { ecrirePanier } from "../scripts/panier";
  const root = document.querySelector<HTMLElement>(".state")!;
  const show = (state: string) => {
    for (const block of root.querySelectorAll<HTMLElement>("[data-show]")) block.hidden = block.dataset.show !== state;
  };

  // Retour de Stripe (session_id) ou lien de la facture envoyée par e-mail (ref).
  const params = new URLSearchParams(location.search);
  const sessionId = params.get("session_id");
  const ref = params.get("ref");
  if (!sessionId && !ref) {
    show("invalide");
  } else {
    const requete = sessionId ? `session_id=${encodeURIComponent(sessionId)}` : `ref=${encodeURIComponent(ref!)}`;
    fetch(`/api/commande?${requete}`, { cache: "no-store" })
      .then((response) => response.json())
      .then((data) => {
        if (data.etat === "paye") {
          // Paiement confirmé : le panier de ce navigateur est vidé.
          ecrirePanier([]);
          const guides: { livre: string; libelle: string; pages: number; lien: string }[] = data.liens ?? [];
          const articles: { produit: string; quantite: number }[] = data.articles ?? [];
          const listeGuides = root.querySelector("[data-liste-guides]")!;
          // Un bloc par livre, avec un lien par fichier : version téléphone et version A4 à imprimer.
          const livres = [...new Set(guides.map((g) => g.livre))];
          listeGuides.replaceChildren(
            ...livres.map((livre) => {
              const li = document.createElement("li");
              li.className = "livre";
              const titre = document.createElement("p");
              titre.className = "livre-titre";
              titre.textContent = livre;
              const boutons = document.createElement("div");
              boutons.className = "livre-liens";
              for (const g of guides.filter((x) => x.livre === livre)) {
                const a = document.createElement("a");
                a.className = "button";
                a.href = g.lien;
                a.textContent = `${g.libelle} (${g.pages} pages)`;
                boutons.append(a);
              }
              li.append(titre, boutons);
              return li;
            }),
          );
          root.querySelector<HTMLElement>("[data-guides]")!.hidden = guides.length === 0;
          root.querySelector<HTMLElement>("[data-note-liens]")!.hidden = guides.length === 0;
          root.querySelector("[data-liste-articles]")!.replaceChildren(
            ...articles.map((a) => {
              const li = document.createElement("li");
              li.textContent = a.quantite > 1 ? `${a.produit} × ${a.quantite}` : a.produit;
              return li;
            }),
          );
          root.querySelector<HTMLElement>("[data-articles]")!.hidden = articles.length === 0;
          root.querySelector("[data-minutes]")!.textContent = String(data.minutes);
          root.querySelector("[data-restants]")!.textContent = String(data.liensRestants);
          if (data.accord) {
            root.querySelector("[data-accord]")!.textContent = data.accord;
            root.querySelector("[data-accord-date]")!.textContent = data.accordDate
              ? new Date(data.accordDate).toLocaleString("fr-FR", { dateStyle: "long", timeStyle: "short" })
              : "";
            root.querySelector<HTMLElement>("[data-accord-zone]")!.hidden = false;
          }
          show("paye");
        } else if (data.etat === "non_paye") show("non_paye");
        else if (data.etat === "limite") show("limite");
        else if (data.etat === "erreur") show("erreur");
        else show("invalide");
      })
      .catch(() => show("erreur"));
  }
</script>

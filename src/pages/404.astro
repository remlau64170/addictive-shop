---
import { BookOpen, Search, ShoppingBag } from "@lucide/astro";
import Base from "../layouts/Base.astro";
---

<Base title="Page introuvable" description="Cette page n'existe pas ou plus sur le site Addictive." noindex>
  <div class="empty introuvable">
    <p class="code" aria-hidden="true">404</p>
    <h1>Page introuvable</h1>
    <p class="lead">Cette page n'existe pas ou a changé d'adresse. Pas d'inquiétude : tout le reste est là.</p>
    <div class="actions">
      <a class="button" href="/boutique/"><ShoppingBag size={18} aria-hidden="true" />Voir la boutique</a>
      <a class="button button-soft" href="/articles/"><BookOpen size={18} aria-hidden="true" />Lire les articles</a>
    </div>
    <p class="note">
      <Search size={16} aria-hidden="true" />
      <span>Vous cherchez quelque chose de précis ? Essayez la <a href="/recherche/">recherche</a> ou revenez à l'<a href="/">accueil</a>.</span>
    </p>
  </div>
</Base>

<style>
  .introuvable {
    text-align: center;
  }

  .code {
    font-size: clamp(4rem, 3rem + 6vw, 7rem);
    font-weight: 800;
    line-height: 1;
    background: linear-gradient(100deg, var(--success), var(--primary) 55%, oklch(0.62 0.17 290));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }

  .actions .button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .note {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1.5rem;
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }

  .note :global(svg) {
    flex: none;
  }
</style>

---
import { Search } from "@lucide/astro";
import Base from "../layouts/Base.astro";
import { getVisibleArticles } from "../lib/articles";
import { getProduits, productName } from "../lib/produits";

const results = [
  ...(await getProduits()).map((produit) => ({
    href: `/boutique/${produit.id}/`,
    type: "Boutique",
    title: productName(produit),
    text: produit.data.summary,
  })),
  ...(await getVisibleArticles()).map((article) => ({
    href: `/articles/${article.id}/`,
    type: "Article",
    title: article.data.title,
    text: article.data.description,
  })),
];
---

<Base title="Recherche" description="Recherchez un produit ou un article Addictive.">
  <h1>Recherche</h1>
  <div class="field needs-js" role="search">
    <Search size={20} aria-hidden="true" />
    <input id="search-input" type="search" placeholder="Un produit, un article…" aria-label="Rechercher sur le site" autocomplete="off" />
  </div>
  <p id="search-count" class="lead" aria-live="polite">{results.length} résultats</p>
  <ul id="search-results" class="stack section">
    {
      results.map((result) => (
        <li data-search={`${result.title} ${result.text} ${result.type}`}>
          <a class="card" href={result.href}>
            <span class="badge">{result.type}</span>
            <h2>{result.title}</h2>
            <p>{result.text}</p>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .field {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 1rem;
    padding-inline: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }

  .field:focus-within {
    border-color: var(--ring);
  }

  input {
    flex: 1;
    min-width: 0;
    min-height: 3rem;
    border: 0;
    outline: 0;
    background: none;
    color: var(--foreground);
    font: inherit;
  }

  input::placeholder {
    color: var(--muted-foreground);
  }

  .card h2 {
    margin-top: 0.5rem;
    font-size: 1.0625rem;
  }
</style>

<script>
  const input = document.querySelector<HTMLInputElement>("#search-input")!;
  const count = document.querySelector("#search-count")!;
  const items = [...document.querySelectorAll<HTMLElement>("#search-results li")];

  // Sans accents ni majuscules : « sobriete » trouve « sobriété ».
  const normalize = (text: string) => text.normalize("NFD").replace(/\p{M}/gu, "").toLowerCase();

  function apply() {
    const words = normalize(input.value).split(/\s+/).filter(Boolean);
    let visible = 0;
    for (const item of items) {
      const text = normalize(item.dataset.search ?? "");
      item.hidden = !words.every((word) => text.includes(word));
      if (!item.hidden) visible += 1;
    }
    if (visible === 0) count.textContent = "Aucun résultat pour l'instant. Essayez un autre mot.";
    else count.textContent = visible === 1 ? "1 résultat" : `${visible} résultats`;
  }

  // La recherche reste après le # : elle n'est jamais envoyée au serveur ni écrite dans ses journaux.
  function readHash() {
    input.value = new URLSearchParams(location.hash.slice(1)).get("q") ?? "";
    apply();
  }

  input.addEventListener("input", () => {
    const query = input.value.trim();
    history.replaceState(null, "", query ? `#q=${encodeURIComponent(query)}` : location.pathname);
    apply();
  });
  addEventListener("hashchange", readHash);
  readHash();
</script>

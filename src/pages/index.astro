---
import {
  ArrowRight,
  Brain,
  Calculator,
  Download,
  Dumbbell,
  Flame,
  Hammer,
  Lock,
  MessageCircle,
  Package,
  ShieldCheck,
  Sparkles,
  Sprout,
} from "@lucide/astro";
import Base from "../layouts/Base.astro";
import JsonLd from "../components/JsonLd.astro";
import StoreLinks from "../components/StoreLinks.astro";
import ProductCard from "../components/ProductCard.astro";
import AppBenefits from "../components/AppBenefits.astro";
import AppVideo from "../components/AppVideo.astro";
import { ARTICLE_CATEGORIES, SHOP_SHELVES } from "../data/site";
import { getVisibleArticles } from "../lib/articles";
import { getProduits } from "../lib/produits";
import { POURQUOI_PARAGRAPHES, POURQUOI_TITRE } from "../data/pourquoi";
import { CONTACT_EMAIL, PUBLISHER, absolute } from "../lib/seo";

const produits = await getProduits();
const articles = await getVisibleArticles();
const derniers = articles.slice(0, 3);


const ENGAGEMENTS = [
  { title: "Contenus vérifiés", text: "Nos ressources sont vérifiées avant publication.", Icon: ShieldCheck },
  { title: "Accès dès le paiement", text: "Pour les produits numériques.", Icon: Download },
  { title: "Fabrication à la demande", text: "Pour les produits physiques.", Icon: Hammer },
  { title: "Paiement sécurisé", text: "Dès l'ouverture de la boutique.", Icon: Lock },
];

const SHELF_ICONS = { numeriques: Sparkles, physiques: Package };

const CATEGORY_ICONS = {
  "envies-et-addictions": Flame,
  "sortir-addiction": Sprout,
  "mental-discipline": Brain,
  "sport-corps": Dumbbell,
  temoignages: MessageCircle,
};

const TUILES = [
  ...SHOP_SHELVES.map((shelf) => ({
    href: shelf.href,
    label: shelf.label,
    note: "Rayon",
    Icon: SHELF_ICONS[shelf.id],
    color: "var(--success)",
  })),
  ...ARTICLE_CATEGORIES.filter((category) => articles.some((article) => article.data.category === category.id)).map((category) => ({
    href: `/articles/#${category.id}`,
    label: category.label,
    note: "Articles",
    Icon: CATEGORY_ICONS[category.id],
    color: "var(--chart-3)",
  })),
];
---

<Base title="Développement personnel, discipline et habitudes" description="Développement personnel, discipline, motivation et remise au sport : articles, programmes et objets pour installer de bonnes habitudes, jusqu'à la sobriété." wide>
  <JsonLd data={{ ...PUBLISHER, email: CONTACT_EMAIL, slogan: "Sois addict à ta sobriété" }} />
  <JsonLd data={{ "@type": "WebSite", name: PUBLISHER.name, url: absolute("/"), inLanguage: "fr" }} />
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <h1>Vos habitudes, <span class="accent">votre progression</span></h1>
        <p class="subtitle">Discipline, mental, sport : avancez chaque jour.</p>
        <p class="hero-actions">
          <a class="button" href="/boutique/">Voir la boutique</a>
          <a class="button button-secondary" href="/appli/">Découvrir l'appli</a>
        </p>
      </div>
      <div class="visual">
        <img
          src="/produits/hero.webp"
          srcset="/produits/hero-800.webp 800w, /produits/hero.webp 1600w"
          sizes="(min-width: 768px) 55vw, 100vw"
          width="1600"
          height="600"
          alt="Les trois livres de la Série 60 et le t-shirt brodé Addictive"
        />
        <span class="demo-note">Visuel de démonstration</span>
      </div>
    </div>
  </section>

  <section class="band" aria-labelledby="phares-title">
    <div class="wrap">
      <h2 id="phares-title">Produits phares</h2>
      <ul class="product-grid">
        {produits.map((produit) => <li><ProductCard produit={produit} /></li>)}
      </ul>
    </div>
  </section>

  <section class="band app-band" aria-labelledby="app-title">
    <div class="wrap">
      <h2 id="app-title">Suivez votre progression avec Addictive</h2>
      <AppVideo />
      <AppBenefits />
      <div class="app-actions">
        <StoreLinks />
        <a class="button button-soft" href="/appli/">Essayer la démo interactive</a>
      </div>
    </div>
  </section>

  <section class="band pledges" aria-label="Nos engagements">
    <ul class="wrap pledges-grid">
      {
        ENGAGEMENTS.map(({ title, text, Icon }) => (
          <li>
            <Icon size={24} color="var(--success)" aria-hidden="true" />
            <div>
              <strong>{title}</strong>
              <p>{text}</p>
            </div>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="band" aria-labelledby="tuiles-title">
    <div class="wrap">
      <h2 id="tuiles-title">Explorer</h2>
      <ul class="tiles">
        {
          TUILES.map(({ href, label, note, Icon, color }) => (
            <li>
              <a class="card tile" href={href}>
                <Icon size={24} color={color} aria-hidden="true" />
                <span class="tile-note">{note}</span>
                <span class="tile-label">{label}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {
    derniers.length > 0 && (
  <section class="band" aria-labelledby="articles-title">
    <div class="wrap">
      <div class="section-head">
        <h2 id="articles-title">Derniers articles</h2>
        <a href="/articles/">Tous les articles<ArrowRight size={16} aria-hidden="true" /></a>
      </div>
          <ul class="latest">
            {derniers.map((article) => (
              <li>
                <a class="card" href={`/articles/${article.id}/`}>
                  {article.data.cover && (
                    <img class="cover" src={article.data.cover.src.replace(".webp", "-800.webp")} width="800" height="450" loading="lazy" alt={article.data.cover.alt} />
                  )}
                  {article.data.draft && <span class="badge badge-violet">Brouillon</span>}
                  <h3>{article.data.title}</h3>
                  <p>{article.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
    </div>
  </section>
    )
  }

  <section class="band" aria-labelledby="outils-title">
    <div class="wrap">
      <a class="card outils" href="/calculateurs/">
        <Calculator size={24} color="var(--success)" aria-hidden="true" />
        <span>
          <span class="outils-titre" id="outils-title">Outils gratuits</span>
          <span class="outils-texte">Calculez l'argent et le temps que vous récupérez, ou ce que quelques minutes par jour représentent.</span>
        </span>
        <ArrowRight size={18} aria-hidden="true" />
      </a>
    </div>
  </section>

  <section class="band pourquoi" aria-labelledby="pourquoi-title">
    <div class="wrap pourquoi-texte">
      <h2 id="pourquoi-title">{POURQUOI_TITRE}</h2>
      {POURQUOI_PARAGRAPHES.map((paragraphe) => <p>{paragraphe}</p>)}
    </div>
  </section>
</Base>

<style>
  .outils {
    display: flex;
    align-items: center;
    gap: 1rem;
    text-decoration: none;
    color: inherit;
  }

  .outils > span {
    display: grid;
    flex: 1;
    gap: 0.25rem;
  }

  .outils-titre {
    font-weight: 700;
  }

  .outils-texte {
    color: var(--muted-foreground);
    font-size: 0.9375rem;
  }

  .outils :global(svg) {
    flex: none;
  }

  /* « Pourquoi Addictive » : du texte simple, comme quelqu'un qui parle. */
  .pourquoi-texte {
    max-width: 40rem;
  }

  .pourquoi-texte p {
    margin-top: 1rem;
    color: var(--muted-foreground);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .pourquoi-texte p:first-of-type {
    color: var(--foreground);
  }

  .band {
    padding-block: var(--space-block);
  }

  .band .wrap > h2 {
    margin-bottom: 1.25rem;
  }

  .band:last-child {
    padding-bottom: var(--space-section);
  }

  /* Haut de page resserré : les produits phares restent visibles dès le premier écran sur téléphone. */
  .hero {
    padding-top: 1rem;
    text-align: center;
  }

  .hero h1 {
    font-size: clamp(1.75rem, 1.1rem + 3vw, 3.25rem);
  }

  .accent {
    background: linear-gradient(90deg, var(--success), var(--primary), var(--chart-3));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .subtitle {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: clamp(0.9375rem, 0.85rem + 0.4vw, 1.1875rem);
  }

  /* Les boutons passent l'un sous l'autre plutôt que de sortir de l'écran quand le texte est agrandi. */
  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-block: 0.875rem;
  }

  .hero-actions .button {
    flex: 1 1 8.5rem;
    min-width: 0;
    padding-inline: 0.5rem;
    font-size: 0.9375rem;
  }

  .hero + .band {
    padding-top: 1.25rem;
  }

  .app-band {
    border-block: 1px solid var(--border);
    background: linear-gradient(
      135deg,
      color-mix(in oklch, var(--success-soft) 45%, transparent),
      color-mix(in oklch, var(--accent) 55%, transparent)
    );
  }

  .app-band .wrap > h2 {
    margin-bottom: 1.5rem;
    text-align: center;
  }

  .app-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.5rem;
  }

  .pledges {
    padding-block: 1.75rem;
    border-bottom: 1px solid var(--border);
  }

  .pledges-grid {
    display: grid;
    gap: 1.125rem 1.5rem;
  }

  .pledges-grid li {
    display: flex;
    gap: 0.75rem;
    min-width: 0;
  }

  .pledges-grid strong {
    display: block;
    line-height: 1.35;
  }

  .pledges-grid p {
    margin-top: 0.125rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
    line-height: 1.45;
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
  }

  /* Une dernière tuile seule sur sa ligne prend toute la largeur, plutôt que de rester dans un coin. */
  /* Une dernière tuile seule sur sa ligne prend toute la largeur (deux colonnes, petits écrans). */
  .tiles li:last-child:nth-child(odd) {
    grid-column: 1 / -1;
  }

  .tiles li {
    display: grid;
    min-width: 0;
  }

  .tile {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem;
  }

  .tile-note {
    margin-top: 0.5rem;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .tile-label {
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
  }

  /* Deux articles se partagent la largeur, trois aussi : jamais de colonne vide. */
  .latest {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 17rem), 1fr));
    gap: 0.75rem;
  }

  .latest .badge {
    margin-bottom: 0.5rem;
  }

  .latest li {
    display: grid;
    min-width: 0;
    max-width: 36rem;
  }

  @media (min-width: 520px) {
    .pledges-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .hero {
      padding-block: clamp(2rem, 4vw, 3.5rem) 1.5rem;
      text-align: left;
    }

    .hero-grid {
      display: grid;
      grid-template-columns: 1fr 1.2fr;
      align-items: center;
      gap: clamp(1.5rem, 4vw, 3.5rem);
    }

    .hero-actions {
      gap: 0.75rem;
      margin-block: 1.5rem 0;
    }

    .hero-actions .button {
      flex: 0 1 auto;
      padding-inline: 1.5rem;
      font-size: 1rem;
    }

    .hero + .band {
      padding-top: var(--space-block);
    }

    .tiles {
      grid-template-columns: repeat(auto-fit, minmax(10.5rem, 1fr));
      gap: 1.25rem;
    }

    .tiles li:last-child:nth-child(odd) {
      grid-column: auto;
    }

    .tile {
      padding: 1.25rem;
    }

    .latest {
      gap: 1.25rem;
    }
  }

  @media (min-width: 900px) {
    .pledges-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

</style>

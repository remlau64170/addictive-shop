---
import Base from "../layouts/Base.astro";
import PhoneShowcase from "../components/PhoneShowcase.astro";
import Breadcrumb from "../components/Breadcrumb.astro";
---

<Base title="L'appli pour suivre vos habitudes et votre sobriété" description="Avec l'appli Addictive, suivez vos habitudes, vos séries et votre progression, et trouvez de l'aide quand une envie arrive. Bientôt disponible." wide>
  <div class="wrap appli">
    <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "L'appli" }]} />
    <h1>L'appli Addictive</h1>
    <p class="lead">Un soutien au quotidien pour reprendre la main, à votre rythme.</p>
    <PhoneShowcase />
    <p class="section"><button class="button" type="button" disabled>Bientôt disponible</button></p>
    <p class="lead">Application réservée aux personnes de 16 ans et plus.</p>
    <p class="lead">En attendant, découvrez <a href="/boutique/">la boutique</a> et <a href="/articles/">nos articles</a>.</p>
  </div>
</Base>

<style>
  .appli {
    padding-block: 1.5rem 2.5rem;
    text-align: center;
  }

  .appli :global(ol) {
    justify-content: center;
  }

  .appli :global(.benefits) {
    text-align: left;
  }
</style>

---
import Base from "../layouts/Base.astro";
import { LEGAL_PAGES } from "../data/site";

export function getStaticPaths() {
  return LEGAL_PAGES.map((page) => ({ params: { legal: page.slug }, props: { label: page.label } }));
}

const { label } = Astro.props;
---

<Base title={label} description={`${label} du site Addictive : page en cours de rédaction.`} noindex>
  <div class="empty">
    <h1>{label}</h1>
    <p class="section"><span class="badge badge-violet">À rédiger</span></p>
  </div>
</Base>

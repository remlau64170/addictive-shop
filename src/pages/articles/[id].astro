---
import { render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Breadcrumb from "../../components/Breadcrumb.astro";
import JsonLd from "../../components/JsonLd.astro";
import { ARTICLE_CATEGORIES } from "../../data/site";
import { faqFromBody, formatDate, getVisibleArticles, lastModified, relatedArticles } from "../../lib/articles";
import { getProduits, productName } from "../../lib/produits";
import { DEFAULT_IMAGE, PUBLISHER, absolute } from "../../lib/seo";

export async function getStaticPaths() {
  const articles = await getVisibleArticles();
  return articles.map((article) => ({ params: { id: article.id }, props: { article, all: articles } }));
}

const { article, all } = Astro.props;
const { Content } = await render(article);
const category = ARTICLE_CATEGORIES.find((item) => item.id === article.data.category);
const cover = article.data.cover;
const related = (await getProduits()).find((produit) => produit.id === article.data.related);
const url = absolute(Astro.url.pathname);
const published = article.data.date;
const modified = lastModified(article);
const isUpdated = modified.getTime() !== published.getTime();
const iso = (date: Date) => date.toISOString().slice(0, 10);
const readMore = relatedArticles(article, all);
const faq = faqFromBody(article.body);
const categoryHref = `/articles/#${article.data.category}`;
const structured = {
  "@type": "Article",
  headline: article.data.title,
  description: article.data.description,
  datePublished: iso(published),
  dateModified: iso(modified),
  inLanguage: "fr-FR",
  url,
  image: absolute(cover?.src ?? DEFAULT_IMAGE),
  mainEntityOfPage: url,
  articleSection: category?.label,
  author: PUBLISHER,
  publisher: PUBLISHER,
};
const faqStructured = faq.length
  ? {
      "@type": "FAQPage",
      inLanguage: "fr-FR",
      mainEntity: faq.map(({ question, answer }) => ({ "@type": "Question", name: question, acceptedAnswer: { "@type": "Answer", text: answer } })),
    }
  : undefined;
---

<Base title={article.data.seoTitle ?? article.data.title} description={article.data.description} ogType="article" noindex={article.data.draft} image={`/partage/articles/${article.id}.jpg`}>
  <Breadcrumb items={[{ label: "Accueil", href: "/" }, { label: "Articles", href: "/articles/" }, ...(category ? [{ label: category.label, href: categoryHref }] : []), { label: article.data.title }]} />
  <JsonLd data={structured} />
  {faqStructured && <JsonLd data={faqStructured} />}
  <article>
    <p class="meta">
      <span class="badge">{category?.label}</span>
      {article.data.draft && <span class="badge badge-violet">Brouillon</span>}
      <span class="dates">
        Publié le <time datetime={iso(published)}>{formatDate(published)}</time>
        {isUpdated && <> · Mis à jour le <time datetime={iso(modified)}>{formatDate(modified)}</time></>}
      </span>
    </p>
    <h1>{article.data.title}</h1>
    {cover && <img class="cover" src={cover.src} width="1600" height="900" alt={cover.alt} />}
    <div class="prose"><Content /></div>
  </article>

  {
    readMore.length > 0 && (
      <aside class="more" aria-labelledby="read-title">
        <h2 id="read-title">À lire aussi</h2>
        <ul class="link-list">
          {readMore.map((other) => (
            <li>
              <a href={`/articles/${other.id}/`}>{other.data.title}</a>
            </li>
          ))}
        </ul>
      </aside>
    )
  }

  <aside class="more" aria-labelledby="more-title">
    <h2 id="more-title">Pour aller plus loin</h2>
    <ul class="link-list">
      {related && <li><a href={`/boutique/${related.id}/`}>{productName(related)}</a></li>}
      <li><a href="/appli/">Suivez vos habitudes avec l'appli Addictive</a></li>
      <li><a href="/articles/">Tous les articles</a></li>
    </ul>
  </aside>
</Base>

<style>
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    margin-block: 0.5rem 0.75rem;
  }

  .dates {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  /* Titre d'article : un peu plus petit que les autres titres de page, pour tenir dans la colonne de lecture. */
  h1 {
    font-size: clamp(1.75rem, 1.45rem + 1.3vw, 2.375rem);
  }

  .cover {
    width: 100%;
    height: auto;
    margin-top: 1.5rem;
    border-radius: var(--radius-card);
  }

  .more {
    margin-top: var(--space-block);
    padding-top: 1.75rem;
    border-top: 1px solid var(--border);
  }

  .more ul {
    margin-top: 1rem;
  }
</style>

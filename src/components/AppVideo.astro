---
import { Play } from "@lucide/astro";

const SOURCE = "/videos/appli-site-16x9.mp4";
---

<!-- La vidéo n'est chargée qu'à l'approche de l'écran ; « réduire les animations » : poster seul et bouton lecture. -->
<div class="app-video">
  <video
    data-src={SOURCE}
    poster="/videos/appli-site-poster.jpg"
    width="1920"
    height="1080"
    muted
    loop
    playsinline
    preload="none"
    aria-label="Démonstration de l'application Addictive : série, calendrier, outil contre les envies et badges"
  ></video>
  <button class="play" type="button" aria-label="Lire la vidéo de démonstration" hidden>
    <Play size={30} aria-hidden="true" />
  </button>
</div>

<style>
  .app-video {
    position: relative;
    width: 100%;
    max-width: 60rem;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border-radius: calc(var(--radius) + 8px);
    background: var(--card);
    box-shadow: var(--shadow-card), 0 0 0 1px var(--border);
  }

  video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .play {
    position: absolute;
    top: 50%;
    left: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 4.5rem;
    height: 4.5rem;
    padding-left: 0.25rem;
    border: 0;
    border-radius: 50%;
    background: var(--primary);
    color: var(--primary-foreground);
    box-shadow: var(--shadow-card);
    cursor: pointer;
    transform: translate(-50%, -50%);
  }

  .play[hidden] {
    display: none;
  }
</style>

<script>
  const reduce = matchMedia("(prefers-reduced-motion: reduce)");

  for (const wrapper of document.querySelectorAll<HTMLElement>(".app-video")) {
    const video = wrapper.querySelector("video")!;
    const button = wrapper.querySelector<HTMLButtonElement>(".play")!;

    const load = () => {
      if (video.dataset.src && !video.getAttribute("src")) video.src = video.dataset.src;
    };
    const play = () => {
      load();
      // Lecture refusée par le navigateur : le bouton reste disponible.
      video.play().then(() => (button.hidden = true)).catch(() => (button.hidden = false));
    };

    button.addEventListener("click", () => {
      video.controls = true;
      play();
    });

    if (reduce.matches) {
      button.hidden = false;
      continue;
    }

    // La source se charge un peu avant l'arrivée à l'écran ; la lecture ne tourne que lorsque la vidéo est visible.
    const loader = new IntersectionObserver(
      ([entry]) => {
        if (!entry?.isIntersecting) return;
        load();
        loader.disconnect();
      },
      { rootMargin: "300px 0px" },
    );
    loader.observe(wrapper);

    new IntersectionObserver(([entry]) => {
      if (!entry) return;
      if (entry.isIntersecting) play();
      else if (!video.paused) video.pause();
    }).observe(wrapper);
  }
</script>

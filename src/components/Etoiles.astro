---
interface Props {
  /** Nombre d'étoiles pleines, de 0 à 5, par demi-étoile (4,5 = quatre étoiles et demie). */
  note: number;
  /** Texte lu par les lecteurs d'écran, par exemple « Note moyenne : 4,5 sur 5 ». */
  label: string;
}

const { note, label } = Astro.props;
const rempli = (Math.max(0, Math.min(5, note)) / 5) * 100;
---

<span class="etoiles" role="img" aria-label={label} style={`--rempli: ${rempli}%`}>
  <span class="rang vide" aria-hidden="true"><i>★</i><i>★</i><i>★</i><i>★</i><i>★</i></span>
  <span class="rang plein" aria-hidden="true"><i>★</i><i>★</i><i>★</i><i>★</i><i>★</i></span>
</span>

<style>
  .etoiles {
    position: relative;
    display: inline-block;
    line-height: 1;
    white-space: nowrap;
  }

  .rang {
    display: inline-flex;
  }

  .rang i {
    flex: none;
    width: 1.25em;
    font-style: normal;
    text-align: center;
  }

  .vide {
    color: color-mix(in oklch, var(--muted-foreground) 40%, transparent);
  }

  /* Les mêmes étoiles par-dessus, coupées à la largeur de la note : une demi-étoile se coupe en son milieu. */
  .plein {
    position: absolute;
    inset: 0 auto 0 0;
    width: var(--rempli);
    overflow: hidden;
    color: var(--warning);
  }
</style>

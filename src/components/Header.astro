---
import { ChevronDown, Menu, Search, ShoppingCart, X } from "@lucide/astro";
import { SHOP_SHELVES } from "../data/site";

const MENU = [
  { href: "/boutique/", label: "Boutique" },
  { href: "/articles/", label: "Articles" },
  { href: "/appli/", label: "L'appli" },
  { href: "/a-propos/", label: "À propos" },
  { href: "/faq/", label: "FAQ" },
];

const path = Astro.url.pathname;
const current = (href: string) => (path.startsWith(href.slice(0, -1)) ? "page" : undefined);
---

<header>
  <div class="wrap bar">
    <details class="burger">
      <summary aria-label="Menu"><Menu size={24} aria-hidden="true" /></summary>
      <nav class="panel" aria-label="Menu">
        <p class="panel-top">
          Menu
          <button class="close needs-js" type="button" data-close-menu aria-label="Fermer le menu">
            <X size={24} aria-hidden="true" />
          </button>
        </p>
        <ul>
          <li><a href="/" aria-current={path === "/" ? "page" : undefined}>Accueil</a></li>
          {
            MENU.map(({ href, label }) => (
              <li>
                {href === "/boutique/" ? (
                  <details class="sub">
                    <summary>{label}<ChevronDown size={18} aria-hidden="true" /></summary>
                    <ul>
                      <li><a href="/boutique/">Toute la boutique</a></li>
                      {SHOP_SHELVES.map((shelf) => (
                        <li><a href={shelf.href}>{shelf.label}</a></li>
                      ))}
                    </ul>
                  </details>
                ) : (
                  <a href={href} aria-current={current(href)}>{label}</a>
                )}
              </li>
            ))
          }
        </ul>
        <p class="panel-help"><a href="/aide/">Besoin d'aide ?</a></p>
      </nav>
    </details>

    <a class="brand" href="/">
      <img src="/logo-64.webp" width="32" height="32" alt="Logo Addictive" />
      Addictive
    </a>

    <nav class="main" aria-label="Navigation principale">
      <ul>
        {
          MENU.map(({ href, label }) => (
            <li class:list={{ "has-menu": href === "/boutique/" }}>
              <a href={href} aria-current={current(href)}>{label}</a>
              {href === "/boutique/" && (
                <ul class="dropdown">
                  <li><a href="/boutique/">Toute la boutique</a></li>
                  {SHOP_SHELVES.map((shelf) => (
                    <li><a href={shelf.href}>{shelf.label}</a></li>
                  ))}
                </ul>
              )}
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="searchbar needs-js" role="search">
      <input id="site-search" type="search" placeholder="Rechercher" aria-label="Rechercher sur le site" autocomplete="off" />
      <a id="site-search-go" href="/recherche/" aria-label="Lancer la recherche"><Search size={18} aria-hidden="true" /></a>
    </div>

    <div class="actions">
      <a class="icon search-link" href="/recherche/" aria-label="Recherche"><Search size={22} aria-hidden="true" /></a>
      <a class="icon cart" href="/panier/" aria-label="Panier"><ShoppingCart size={22} aria-hidden="true" /><span class="cart-count" hidden></span></a>
    </div>
  </div>
</header>

<style>
  .cart {
    position: relative;
  }

  .cart-count {
    position: absolute;
    top: 0.2rem;
    right: 0.1rem;
    min-width: 1.15rem;
    height: 1.15rem;
    padding: 0 0.3rem;
    border-radius: var(--radius-pill);
    background: var(--primary);
    color: var(--primary-foreground);
    font-size: 0.6875rem;
    font-weight: 700;
    line-height: 1.15rem;
    text-align: center;
  }

  .cart-count[hidden] {
    display: none;
  }

  header {
    border-bottom: 1px solid var(--border);
  }

  .bar {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 0.25rem;
    padding-block: 0.25rem;
    padding-inline: 0.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--foreground);
    font-weight: 800;
    text-decoration: none;
  }

  .brand img {
    border-radius: 0.5rem;
  }

  .actions {
    display: flex;
    justify-content: flex-end;
    min-width: 0;
  }

  .icon,
  .burger > summary,
  .close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    color: var(--foreground);
  }

  .icon:hover {
    color: var(--primary);
  }

  summary {
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  /* Le voile derrière le panneau ferme le menu au toucher, même sans JavaScript. */
  .burger[open] > summary::before {
    content: "";
    position: fixed;
    inset: 0;
    z-index: 50;
    background: oklch(0 0 0 / 0.6);
  }

  .panel {
    position: fixed;
    inset: 0 auto 0 0;
    z-index: 51;
    width: min(85%, 20rem);
    padding: 0.5rem 1rem 1.5rem;
    overflow-y: auto;
    background: var(--card);
    box-shadow: var(--shadow-card);
  }

  .panel-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 2.75rem;
    font-weight: 800;
  }

  .close {
    border: 0;
    background: none;
    cursor: pointer;
  }

  .sub summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 3rem;
    font-weight: 600;
  }

  .sub[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  .sub ul {
    padding-left: 1rem;
  }

  .panel a {
    display: flex;
    align-items: center;
    min-height: 3rem;
    color: var(--foreground);
    font-weight: 600;
    text-decoration: none;
  }

  .sub a {
    font-weight: 500;
  }

  .panel .panel-help {
    margin-top: 1.25rem;
    padding-top: 0.5rem;
    border-top: 1px solid var(--border);
  }

  .panel-help a {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .panel a[aria-current="page"] {
    color: var(--primary);
  }

  .main,
  .searchbar {
    display: none;
  }

  @media (min-width: 900px) {
    .bar {
      display: flex;
      gap: 1.5rem;
      padding-block: 0.5rem;
      padding-inline: 1.5rem;
    }

    .burger,
    .search-link {
      display: none;
    }

    .main {
      display: block;
    }

    .main > ul {
      display: flex;
      gap: 0.25rem;
    }

    .main > ul > li {
      position: relative;
    }

    .main > ul > li > a {
      display: flex;
      align-items: center;
      min-height: 2.75rem;
      padding-inline: 0.625rem;
      color: var(--foreground);
      font-size: 0.9375rem;
      font-weight: 600;
      text-decoration: none;
    }

    .main > ul > li > a:hover,
    .main > ul > li > a[aria-current="page"] {
      color: var(--primary);
    }

    .dropdown {
      position: absolute;
      top: 100%;
      left: 0;
      z-index: 50;
      display: none;
      min-width: 13rem;
      padding: 0.75rem 1.25rem;
      border: 1px solid var(--border);
      border-radius: var(--radius);
      background: var(--card);
      box-shadow: var(--shadow-card);
    }

    .has-menu:hover .dropdown,
    .has-menu:focus-within .dropdown {
      display: block;
    }

    .dropdown a {
      display: flex;
      align-items: center;
      min-height: 2.25rem;
      color: var(--foreground);
      font-size: 0.9375rem;
      text-decoration: none;
    }

    .dropdown a:hover {
      color: var(--primary);
    }

    .searchbar {
      display: flex;
      flex: 1;
      min-width: 0;
      max-width: 22rem;
      margin-left: auto;
      border: 1px solid var(--border);
      border-radius: 999px;
      background: var(--card);
    }

    .searchbar:focus-within {
      border-color: var(--ring);
      box-shadow: 0 0 0 1px var(--ring);
    }

    .searchbar input {
      flex: 1;
      min-width: 0;
      padding: 0.5rem 0 0.5rem 1rem;
      border: 0;
      outline: 0;
      background: none;
      color: var(--foreground);
      font: inherit;
      font-size: 0.9375rem;
    }

    .searchbar input::placeholder {
      color: var(--muted-foreground);
    }

    .searchbar a {
      display: flex;
      align-items: center;
      justify-content: center;
      width: 2.75rem;
      min-height: 2.5rem;
      color: var(--foreground);
    }
  }
</style>

<script>
  const burger = document.querySelector<HTMLDetailsElement>(".burger");
  const closeBurger = () => burger?.removeAttribute("open");

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") closeBurger();
  });
  document.querySelector("[data-close-menu]")?.addEventListener("click", closeBurger);
  document.querySelectorAll(".panel a").forEach((link) => link.addEventListener("click", closeBurger));

  // La recherche reste après le # : elle n'est jamais envoyée au serveur ni écrite dans ses journaux.
  const input = document.querySelector<HTMLInputElement>("#site-search");
  const go = () => {
    const query = input?.value.trim();
    location.assign(query ? `/recherche/#q=${encodeURIComponent(query)}` : "/recherche/");
  };
  input?.addEventListener("keydown", (event) => {
    if (event.key === "Enter") go();
  });
  document.querySelector("#site-search-go")?.addEventListener("click", (event) => {
    event.preventDefault();
    go();
  });
</script>

<script>
  import { nombreArticles, surChangementPanier } from "../scripts/panier";

  // Nombre d'articles du panier sur l'icône, et dans le nom lu par les lecteurs d'écran.
  const lien = document.querySelector<HTMLAnchorElement>("header .cart");
  const pastille = lien?.querySelector<HTMLElement>(".cart-count");
  const afficher = () => {
    if (!lien || !pastille) return;
    const n = nombreArticles();
    pastille.textContent = String(n);
    pastille.hidden = n === 0;
    lien.setAttribute("aria-label", n === 0 ? "Panier" : `Panier, ${n} article${n > 1 ? "s" : ""}`);
  };
  afficher();
  surChangementPanier(afficher);
</script>

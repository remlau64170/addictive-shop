---
import { Award, CalendarDays, ChartLine, Compass, Zap } from "@lucide/astro";
import { initialState, renderApp, type Route } from "../demo/screens";
import "../demo/demo.css";

const AVANTAGES = [
  { title: "Votre série", text: "Voyez votre progression d'un coup d'œil.", Icon: ChartLine, color: "var(--success)" },
  { title: "Votre calendrier", text: "Retrouvez votre parcours, jour après jour.", Icon: CalendarDays, color: "var(--primary)" },
  { title: "Une aide immédiate", text: "Une activité, un quiz ou un mini-jeu quand une envie arrive.", Icon: Zap, color: "var(--chart-3)" },
  { title: "Vos badges", text: "Célébrez chaque étape franchie.", Icon: Award, color: "var(--success)" },
  { title: "AddictForms", text: "Des vidéos, des conseils et des numéros d'aide vérifiés.", Icon: Compass, color: "var(--primary)" },
];

const state = initialState();
const app = (route: Route) => renderApp(route, state);

// Téléphones décoratifs : de vrais écrans de la démo, figés. Le premier est répété en fin de boucle pour un retour sans saut.
const DECOR: { position: string; start: number; routes: Route[] }[] = [
  { position: "left", start: 0, routes: [{ name: "fiche", id: "tabac" }, { name: "envies" }, { name: "choose" }] },
  { position: "right", start: 1, routes: [{ name: "compte" }, { name: "forms" }, { name: "news" }] },
];
---

<div class="scene">
  {
    DECOR.map(({ position, start, routes }) => (
      <div class:list={["float", position]} style={`--start: ${start}`} aria-hidden="true" inert>
        <div class="phone">
          <div class="screen">
            <span class="island" />
            <div class="fit">
              <div class="track">
                {[...routes, routes[0]!].map((route) => (
                  <div class="app" set:html={app(route)} />
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    ))
  }
  <div class="float center" style="--start: 2">
    <div class="phone">
      <div class="screen">
        <span class="island" />
        <div class="fit">
          <div id="demo-root" class="app" role="region" aria-label="Démo interactive de l'appli Addictive, données fictives" set:html={app({ name: "home" })} />
        </div>
      </div>
    </div>
  </div>
</div>
<p class="mention">Démo interactive, données fictives</p>

<ul class="benefits">
  {
    AVANTAGES.map(({ title, text, Icon, color }) => (
      <li>
        <Icon size={24} color={color} aria-hidden="true" />
        <strong>{title}</strong>
        <p>{text}</p>
      </li>
    ))
  }
</ul>

<style>
  /* Tailles fixes par palier : `--s` réduit l'écran de 360 px de large à la largeur `--w` du téléphone. */
  .scene {
    --w: 300px;
    --s: 0.83333;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    padding-block: 1.5rem 2rem;
    overflow-x: clip;
  }

  .float {
    flex: none;
  }

  /* Le téléphone interactif vient en dernier dans la page, mais s'affiche au milieu. */
  .center {
    order: 1;
  }

  .right {
    order: 2;
  }

  .left,
  .right {
    display: none;
  }

  .phone {
    position: relative;
    padding: 9px;
    border-radius: 44px;
    background: linear-gradient(135deg, oklch(0.5 0.03 258), oklch(0.26 0.03 264) 45%, oklch(0.4 0.03 258));
    box-shadow:
      inset 0 0 0 1px oklch(0.62 0.03 258 / 0.7),
      5px 4px 0 oklch(0.2 0.03 264),
      12px 22px 34px oklch(0 0 0 / 0.55);
  }

  /* Boutons sur la tranche. */
  .phone::before,
  .phone::after {
    content: "";
    position: absolute;
    left: -3px;
    width: 4px;
    border-radius: 2px 0 0 2px;
    background: oklch(0.42 0.03 258);
  }

  .phone::before {
    top: 17%;
    height: 6%;
  }

  .phone::after {
    top: 25%;
    height: 11%;
  }

  .screen {
    position: relative;
    width: var(--w);
    aspect-ratio: 360 / 780;
    overflow: hidden;
    border-radius: 36px;
    background: var(--background);
  }

  .island {
    position: absolute;
    top: 9px;
    left: 50%;
    z-index: 1;
    width: 30%;
    height: 20px;
    border-radius: 999px;
    background: oklch(0.08 0.01 264);
    transform: translateX(-50%);
    pointer-events: none;
  }

  .fit {
    position: absolute;
    top: 0;
    left: 0;
    width: 360px;
    height: 780px;
    transform: scale(var(--s));
    transform-origin: 0 0;
  }

  .track {
    display: flex;
    flex-direction: column;
    height: 400%;
    /* Sans animation, chaque téléphone reste sur un écran différent. */
    transform: translateY(calc(var(--start) * -25%));
  }

  .mention {
    color: var(--muted-foreground);
    font-size: 0.8125rem;
    text-align: center;
  }

  .benefits {
    display: grid;
    gap: 0.75rem;
    margin-top: 1.25rem;
    text-align: left;
  }

  .benefits li {
    min-width: 0;
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--card);
  }

  .benefits strong {
    display: block;
    margin-top: 0.5rem;
  }

  .benefits p {
    margin-top: 0.125rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  @media (max-width: 339px) {
    .scene {
      --w: 260px;
      --s: 0.72222;
    }
  }

  @media (min-width: 600px) {
    .benefits {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 768px) {
    .scene {
      padding-block: 2rem 3rem;
    }

    .left,
    .right {
      display: block;
    }

    .left .screen,
    .right .screen {
      width: 220px;
    }

    .left .fit,
    .right .fit {
      transform: scale(0.61111);
    }

    .left {
      margin-top: 44px;
      margin-right: -18px;
    }

    .right {
      margin-top: 28px;
      margin-left: -18px;
    }

    .center {
      position: relative;
      z-index: 1;
    }

    .left .phone {
      transform: perspective(1100px) rotateX(3deg) rotateY(22deg) rotateZ(-3deg);
    }

    .right .phone {
      transform: perspective(1100px) rotateX(3deg) rotateY(-22deg) rotateZ(3deg);
    }
  }

  @media (min-width: 1000px) {
    .benefits {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  @media (min-width: 1100px) {
    .scene {
      --w: 320px;
      --s: 0.88889;
    }

    .left .screen,
    .right .screen {
      width: 250px;
    }

    .left .fit,
    .right .fit {
      transform: scale(0.69444);
    }
  }

  /* Animation seulement si la personne n'a pas activé « réduire les animations ». */
  @media (prefers-reduced-motion: no-preference) {
    .float {
      animation: float 7s ease-in-out infinite;
      animation-delay: calc(var(--start) * -1.5s);
    }

    .track {
      animation: screens 24s ease-in-out infinite;
      animation-delay: calc(var(--start) * -8s);
    }

    /* Le téléphone interactif s'immobilise dès qu'on s'en sert. */
    .center:hover,
    .center.touched {
      animation: none;
    }
  }

  @keyframes float {
    50% {
      transform: translateY(-1.5%);
    }
  }

  @keyframes screens {
    0%,
    28% {
      transform: translateY(0);
    }

    33%,
    61% {
      transform: translateY(-25%);
    }

    66%,
    94% {
      transform: translateY(-50%);
    }

    100% {
      transform: translateY(-75%);
    }
  }
</style>

<script>
  // Le code de la démo n'est chargé que lorsque le téléphone arrive à l'écran.
  const root = document.querySelector<HTMLElement>("#demo-root");
  if (root) {
    const observer = new IntersectionObserver(
      (entries) => {
        if (!entries.some((entry) => entry.isIntersecting)) return;
        observer.disconnect();
        void import("../demo/app").then(({ start }) => start(root));
      },
      { rootMargin: "200px" },
    );
    observer.observe(root);
  }
</script>

---
import { ChevronDown } from "@lucide/astro";
import { LEGAL_PAGES, SHOP_SHELVES, SLOGAN } from "../data/site";

const COLUMNS = [
  {
    title: "Boutique",
    links: [
      { href: "/boutique/", label: "Toute la boutique" },
      ...SHOP_SHELVES,
    ],
  },
  {
    title: "Informations légales",
    links: LEGAL_PAGES.map((page) => ({ href: `/${page.slug}/`, label: page.label })),
  },
  {
    title: "Addictive",
    links: [
      { href: "/articles/", label: "Articles" },
      { href: "/appli/", label: "L'appli" },
      { href: "/a-propos/", label: "À propos" },
      { href: "/faq/", label: "Questions fréquentes" },
      { href: "/contact/", label: "Contact" },
    ],
  },
];
---

<footer>
  <div class="wrap columns">
    {
      COLUMNS.map(({ title, links }) => (
        <details>
          <summary>{title}<ChevronDown size={18} aria-hidden="true" /></summary>
          <ul>
            {links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>
  <div class="wrap bottom">
    <a class="help" href="/aide/">Besoin d'aide ?</a>
    <p class="signature">{SLOGAN}</p>
    <p>© 2026 Addictive. Nos contenus ne remplacent pas l'avis d'un professionnel de santé.</p>
  </div>
</footer>

<style>
  footer {
    margin-top: 2rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--border);
    background: var(--card);
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 3rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  ul {
    padding-bottom: 1rem;
  }

  li a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.875rem;
  }

  .bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0 1.5rem;
    margin-top: 0.75rem;
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .signature {
    color: var(--foreground);
    font-weight: 700;
  }

  .help {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    color: var(--muted-foreground);
  }

  @media (min-width: 900px) {
    .columns {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 2.5rem;
    }

    details {
      border: 0;
    }

    summary {
      min-height: 0;
      margin-bottom: 0.5rem;
    }

    li a {
      min-height: 2rem;
    }

    /* Sur ordinateur, les colonnes sont toujours ouvertes. Navigateur trop ancien : elles restent simplement repliables. */
    @supports selector(::details-content) {
      details::details-content {
        display: block;
        content-visibility: visible;
        height: auto;
      }

      summary {
        pointer-events: none;
      }

      summary :global(svg) {
        display: none;
      }
    }
  }
</style>

---
import { ChevronDown, ExternalLink, Phone, TriangleAlert } from "@lucide/astro";
import { EMERGENCY, HELPLINES, telHref } from "../data/helplines";
import { LEGAL_PAGES, SHOP_NEEDS, SHOP_SHELVES } from "../data/site";

const BOUTIQUE = [
  { href: "/boutique/", label: "Toute la boutique" },
  ...SHOP_SHELVES.map((shelf) => ({ href: `/boutique/#type=${shelf.id}`, label: shelf.label })),
  ...SHOP_NEEDS.map((need) => ({ href: `/boutique/#besoin=${need.id}`, label: need.label })),
];
const ADDICTIVE = [
  { href: "/articles/", label: "Articles" },
  { href: "/appli/", label: "L'appli" },
  { href: "/a-propos/", label: "À propos" },
];
const LEGAL = LEGAL_PAGES.map((page) => ({ href: `/${page.slug}/`, label: page.label }));
---

<footer>
  <div class="wrap columns">
    <section class="help" aria-labelledby="help-title">
      <h2 id="help-title">Aide et numéros d'urgence</h2>
      <p class="intro">Ces services vous écoutent, vous informent et vous orientent.</p>

      <!-- Les urgences restent toujours visibles : elles ne sont jamais dans un bloc repliable. -->
      <div class="emergency">
        <h3><TriangleAlert size={16} aria-hidden="true" />{EMERGENCY.title}</h3>
        <ul>
          {
            EMERGENCY.lines.map((line) => (
              <li>
                <p>{line.text}</p>
                <div class="calls">
                  {line.calls.map((call) => (
                    <a href={telHref(call.phoneHref)}>
                      <Phone size={16} aria-hidden="true" />
                      Appeler le {call.label}
                    </a>
                  ))}
                </div>
              </li>
            ))
          }
        </ul>
      </div>

      <details open>
        <summary>Numéros d'aide<ChevronDown size={18} aria-hidden="true" /></summary>
        <ul class="helplines">
          {
            HELPLINES.map((helpline) => (
              <li>
                <h3>{helpline.name}</h3>
                <a
                  class="number"
                  href={telHref(helpline.phoneHref)}
                  aria-label={`Appeler ${helpline.name}, ${helpline.phone}`}
                >
                  <Phone size={16} aria-hidden="true" />
                  {helpline.phone}
                </a>
                <p class="hours">
                  {helpline.hours}
                  {helpline.details ? ` · ${helpline.details}` : ""}
                </p>
                {helpline.site && (
                  <a
                    class="site"
                    href={helpline.site.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-label={`${helpline.site.label} (s'ouvre dans un nouvel onglet)`}
                  >
                    {helpline.site.label}
                    <ExternalLink size={14} aria-hidden="true" />
                  </a>
                )}
              </li>
            ))
          }
        </ul>
      </details>
    </section>

    {
      [
        { className: "col-boutique", title: "Boutique", links: BOUTIQUE },
        { className: "col-legal", title: "Informations légales", links: LEGAL },
        { className: "col-addictive", title: "Addictive", links: ADDICTIVE },
      ].map(({ className, title, links }) => (
        <details class={className}>
          <summary>{title}<ChevronDown size={18} aria-hidden="true" /></summary>
          <ul class="links">
            {links.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </details>
      ))
    }
  </div>
  <p class="wrap note">© 2026 Addictive. Nos contenus ne remplacent pas l'avis d'un professionnel de santé.</p>
</footer>

<style>
  footer {
    margin-top: 2rem;
    padding-block: 2rem;
    border-top: 1px solid var(--border);
    background: var(--card);
  }

  h2 {
    font-size: 1.0625rem;
  }

  .intro,
  .hours,
  .note {
    color: var(--muted-foreground);
    font-size: 0.875rem;
  }

  .intro {
    margin-top: 0.25rem;
  }

  .emergency {
    margin-top: 1rem;
    padding: 1rem;
    border: 1px solid color-mix(in oklch, var(--danger) 40%, transparent);
    border-radius: var(--radius);
    background: color-mix(in oklch, var(--danger-soft) 40%, transparent);
  }

  .emergency h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--danger);
    font-size: 0.875rem;
  }

  .emergency li {
    margin-top: 0.75rem;
    font-size: 0.875rem;
    font-weight: 500;
  }

  .calls {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }

  .calls a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    padding: 0.25rem 0.75rem;
    border: 1px solid color-mix(in oklch, var(--danger) 50%, transparent);
    border-radius: 0.75rem;
    color: var(--foreground);
    text-decoration: none;
  }

  details {
    border-bottom: 1px solid var(--border);
  }

  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem;
    min-height: 3rem;
    font-weight: 700;
    cursor: pointer;
    list-style: none;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  details[open] summary :global(svg) {
    transform: rotate(180deg);
  }

  .helplines li + li {
    margin-top: 1.25rem;
  }

  .helplines,
  .links {
    padding-bottom: 1rem;
  }

  .helplines h3 {
    font-size: 0.9375rem;
  }

  .number {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 2.75rem;
    color: var(--foreground);
    font-size: 1.125rem;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    text-decoration: none;
  }

  .site {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    min-height: 2.75rem;
    font-size: 0.875rem;
    overflow-wrap: anywhere;
  }

  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    font-size: 0.875rem;
  }

  .note {
    margin-top: 1rem;
  }

  @media (min-width: 900px) {
    .columns {
      display: grid;
      grid-template-columns: 1fr 2.4fr 1fr 1fr;
      gap: 2.5rem;
    }

    .col-boutique {
      grid-area: 1 / 1;
    }

    .help {
      grid-area: 1 / 2;
    }

    .col-legal {
      grid-area: 1 / 3;
    }

    .col-addictive {
      grid-area: 1 / 4;
    }

    details {
      border: 0;
    }

    h2,
    .col-boutique summary,
    .col-legal summary,
    .col-addictive summary {
      min-height: 0;
      margin-bottom: 0.5rem;
      font-size: 1rem;
      font-weight: 700;
    }

    .help details summary {
      min-height: 2.5rem;
    }

    .links a {
      min-height: 2rem;
    }

    .helplines {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem 1.5rem;
    }

    .helplines li + li {
      margin-top: 0;
    }

    /* Sur ordinateur, les colonnes sont toujours ouvertes. Navigateur trop ancien : elles restent simplement repliables. */
    @supports selector(::details-content) {
      details::details-content {
        display: block;
        content-visibility: visible;
        height: auto;
      }

      summary {
        pointer-events: none;
      }

      summary :global(svg) {
        display: none;
      }
    }
  }
</style>

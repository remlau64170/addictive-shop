---
import { formatPrice, productName, thumbnail, type Produit } from "../lib/produits";

interface Props {
  produit: Produit;
  heading?: "h2" | "h3";
}

const { produit, heading: Heading = "h3" } = Astro.props;
const href = `/boutique/${produit.id}/`;
---

<article>
  <a class="visual" href={href} tabindex="-1">
    <img src={thumbnail(produit.data.images[0]!.src)} width="480" height="480" loading="lazy" alt={produit.data.images[0]!.alt} />
    <span class="demo-note">Visuel de démonstration</span>
  </a>
  <Heading class="name"><a href={href}>{productName(produit)}</a></Heading>
  <p class="price">{formatPrice(produit.data.price)}</p>
  <a class="button button-soft" href={href} tabindex="-1" aria-hidden="true">Voir le produit</a>
</article>

<style>
  article {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: 0.625rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-card);
    background: var(--card);
    transition: border-color var(--ease);
  }

  article:hover {
    border-color: var(--border-strong);
  }

  .visual {
    display: block;
  }

  .visual img {
    border-radius: var(--radius-inner);
  }

  .name {
    margin-top: 0.75rem;
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.3;
    text-wrap: wrap;
  }

  .name a {
    color: var(--foreground);
    text-decoration: none;
  }

  .name a:hover {
    text-decoration: underline;
  }

  .price {
    margin-block: 0.25rem 0.75rem;
    font-size: 1rem;
    font-weight: 800;
  }

  .button {
    margin-top: auto;
    padding-inline: 0.5rem;
    font-size: 0.875rem;
  }

  /* Au survol de la carte, son bouton prend la couleur du bouton principal. */
  article:hover .button {
    background: var(--primary);
    color: var(--primary-foreground);
  }

  @media (min-width: 768px) {
    article {
      padding: 0.875rem;
    }

    .name {
      font-size: 1rem;
    }

    .price {
      font-size: 1.0625rem;
    }
  }
</style>

---
import { ChevronRight } from "@lucide/astro";
import JsonLd from "./JsonLd.astro";
import { absolute } from "../lib/seo";

interface Props {
  /** Dernier élément sans `href` : c'est la page en cours. */
  items: { label: string; href?: string }[];
}

const { items } = Astro.props;
const structured = {
  "@type": "BreadcrumbList",
  itemListElement: items.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.label,
    item: absolute(item.href ?? Astro.url.pathname),
  })),
};
---

<nav aria-label="Fil d'Ariane">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {index > 0 && <ChevronRight size={14} aria-hidden="true" />}
          {item.href ? <a href={item.href}>{item.label}</a> : <span aria-current="page">{item.label}</span>}
        </li>
      ))
    }
  </ol>
</nav>
<JsonLd data={structured} />

<style>
  /* Une seule ligne : un titre long se termine par « … » au lieu de passer seul à la ligne. */
  ol {
    display: flex;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 0.875rem;
    line-height: 2.75rem;
  }

  li {
    display: flex;
    flex: 0 1 auto;
    align-items: center;
    gap: 0.25rem;
    min-width: 0;
    margin-right: 0.25rem;
    color: var(--muted-foreground);
  }

  li:last-child {
    flex-shrink: 100;
    min-width: 3rem;
    margin-right: 0;
  }

  a,
  [aria-current] {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  a {
    color: var(--muted-foreground);
    text-decoration: none;
  }

  a:hover {
    color: var(--foreground);
    text-decoration: underline;
  }

  a:focus-visible {
    outline-offset: -2px;
  }

  [aria-current] {
    color: var(--foreground);
    font-weight: 600;
  }

  /* Petit écran, page en profondeur : le titre de la page est juste dessous, le fil garde seulement le chemin. */
  @media (max-width: 599px) {
    li:last-child:not(:nth-child(-n + 2)) {
      display: none;
    }
  }

  /* Très petit écran, chemin de quatre niveaux : le logo ramène déjà à l'accueil, le fil commence au rayon. */
  @media (max-width: 419px) {
    li:first-child:nth-last-child(n + 4),
    li:first-child:nth-last-child(n + 4) + li :global(svg) {
      display: none;
    }
  }
</style>
